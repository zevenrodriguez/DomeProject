#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

// Gaussian Splatting utilities (moved from GaussianSplatting.hlsl)
#ifndef GAUSSIAN_SPLATTING_HLSL
#define GAUSSIAN_SPLATTING_HLSL

float InvSquareCentered01(float x)
{
    x -= 0.5;
    x *= 0.5;
    x = sqrt(abs(x)) * sign(x);
    return x + 0.5;
}

float3 QuatRotateVector(float3 v, float4 r)
{
    float3 t = 2 * cross(r.xyz, v);
    return v + r.w * t + cross(r.xyz, t);
}

float4 QuatMul(float4 a, float4 b)
{
    return float4(a.wwww * b + (a.xyzx * b.wwwx + a.yzxy * b.zxyy) * float4(1,1,1,-1) - a.zxyz * b.yzxz);
}

float4 QuatInverse(float4 q)
{
    return rcp(dot(q, q)) * q * float4(-1,-1,-1,1);
}

float3x3 CalcMatrixFromRotationScale(float4 rot, float3 scale)
{
    float3x3 ms = float3x3(
        scale.x, 0, 0,
        0, scale.y, 0,
        0, 0, scale.z
    );
    float x = rot.x;
    float y = rot.y;
    float z = rot.z;
    float w = rot.w;
    float3x3 mr = float3x3(
        1-2*(y*y + z*z),   2*(x*y - w*z),   2*(x*z + w*y),
          2*(x*y + w*z), 1-2*(x*x + z*z),   2*(y*z - w*x),
          2*(x*z - w*y),   2*(y*z + w*x), 1-2*(x*x + y*y)
    );
    return mul(mr, ms);
}

void CalcCovariance3D(float3x3 rotMat, out float3 sigma0, out float3 sigma1)
{
    float3x3 sig = mul(rotMat, transpose(rotMat));
    sigma0 = float3(sig._m00, sig._m01, sig._m02);
    sigma1 = float3(sig._m11, sig._m12, sig._m22);
}

// from "EWA Splatting" (Zwicker et al 2002) eq. 31
float3 CalcCovariance2D(float3 worldPos, float3 cov3d0, float3 cov3d1, float4x4 matrixV, float4x4 matrixP, float4 screenParams)
{
    float4x4 viewMatrix = matrixV;
    float3 viewPos = mul(viewMatrix, float4(worldPos, 1)).xyz;

    // this is needed in order for splats that are visible in view but clipped "quite a lot" to work
    float aspect = matrixP._m00 / matrixP._m11;
    float tanFovX = rcp(matrixP._m00);
    float tanFovY = rcp(matrixP._m11 * aspect);
    float limX = 1.3 * tanFovX;
    float limY = 1.3 * tanFovY;
    viewPos.x = clamp(viewPos.x / viewPos.z, -limX, limX) * viewPos.z;
    viewPos.y = clamp(viewPos.y / viewPos.z, -limY, limY) * viewPos.z;

    float focal = screenParams.x * matrixP._m00 / 2;

    float3x3 J = float3x3(
        focal / viewPos.z, 0, -(focal * viewPos.x) / (viewPos.z * viewPos.z),
        0, focal / viewPos.z, -(focal * viewPos.y) / (viewPos.z * viewPos.z),
        0, 0, 0
    );
    float3x3 W = (float3x3)viewMatrix;
    float3x3 T = mul(J, W);
    float3x3 V = float3x3(
        cov3d0.x, cov3d0.y, cov3d0.z,
        cov3d0.y, cov3d1.x, cov3d1.y,
        cov3d0.z, cov3d1.y, cov3d1.z
    );
    float3x3 cov = mul(T, mul(V, transpose(T)));

    // Low pass filter to make each splat at least 1px size.
    cov._m00 += 0.3;
    cov._m11 += 0.3;
    return float3(cov._m00, cov._m01, cov._m11);
}

float3 CalcConic(float3 cov2d)
{
    float det = cov2d.x * cov2d.z - cov2d.y * cov2d.y;
    return float3(cov2d.z, -cov2d.y, cov2d.x) * rcp(det);
}

float2 CalcScreenSpaceDelta(float2 svPositionXY, float2 centerXY, float4 projectionParams)
{
    float2 d = svPositionXY - centerXY;
    d.y *= projectionParams.x;
    return d;
}

float CalcPowerFromConic(float3 conic, float2 d)
{
    return -0.5 * (conic.x * d.x*d.x + conic.z * d.y*d.y) + conic.y * d.x*d.y;
}

// Morton interleaving 16x16 group i.e. by 4 bits of coordinates, based on this thread:
// https://twitter.com/rygorous/status/986715358852608000
// which is simplified version of https://fgiesen.wordpress.com/2009/12/13/decoding-morton-codes/
uint EncodeMorton2D_16x16(uint2 c)
{
    uint t = ((c.y & 0xF) << 8) | (c.x & 0xF); // ----EFGH----ABCD
    t = (t ^ (t << 2)) & 0x3333;               // --EF--GH--AB--CD
    t = (t ^ (t << 1)) & 0x5555;               // -E-F-G-H-A-B-C-D
    return (t | (t >> 7)) & 0xFF;              // --------EAFBGCHD
}
uint2 DecodeMorton2D_16x16(uint t)      // --------EAFBGCHD
{
    t = (t & 0xFF) | ((t & 0xFE) << 7); // -EAFBGCHEAFBGCHD
    t &= 0x5555;                        // -E-F-G-H-A-B-C-D
    t = (t ^ (t >> 1)) & 0x3333;        // --EF--GH--AB--CD
    t = (t ^ (t >> 2)) & 0x0f0f;        // ----EFGH----ABCD
    return uint2(t & 0xF, t >> 8);      // --------EFGHABCD
}


static const float SH_C1 = 0.4886025;
static const float SH_C2[] = { 1.0925484, -1.0925484, 0.3153916, -1.0925484, 0.5462742 };
static const float SH_C3[] = { -0.5900436, 2.8906114, -0.4570458, 0.3731763, -0.4570458, 1.4453057, -0.5900436 };

struct SplatSHData
{
    half3 col, sh1, sh2, sh3, sh4, sh5, sh6, sh7, sh8, sh9, sh10, sh11, sh12, sh13, sh14, sh15;
};

// GLES3/Vulkan: asuint(half3/float3) is invalid — pack per scalar component.
uint3 PackHalf3AsUintBits(half3 v)
{
    return uint3(asuint((float)v.x), asuint((float)v.y), asuint((float)v.z));
}

uint3 PackFloat3AsUintBits(float3 v)
{
    return uint3(asuint(v.x), asuint(v.y), asuint(v.z));
}

half3 ShadeSH(SplatSHData splat, half3 dir, int shOrder, bool onlySH)
{
    dir *= -1;

    half x = dir.x, y = dir.y, z = dir.z;

    // ambient band
    half3 res = splat.col; // col = sh0 * SH_C0 + 0.5 is already precomputed
    if (onlySH)
        res = 0.5;
    // 1st degree
    if (shOrder >= 1)
    {
        res += SH_C1 * (-splat.sh1 * y + splat.sh2 * z - splat.sh3 * x);
        // 2nd degree
        if (shOrder >= 2)
        {
            half xx = x * x, yy = y * y, zz = z * z;
            half xy = x * y, yz = y * z, xz = x * z;
            res +=
                (SH_C2[0] * xy) * splat.sh4 +
                (SH_C2[1] * yz) * splat.sh5 +
                (SH_C2[2] * (2 * zz - xx - yy)) * splat.sh6 +
                (SH_C2[3] * xz) * splat.sh7 +
                (SH_C2[4] * (xx - yy)) * splat.sh8;
            // 3rd degree
            if (shOrder >= 3)
            {
                res +=
                    (SH_C3[0] * y * (3 * xx - yy)) * splat.sh9 +
                    (SH_C3[1] * xy * z) * splat.sh10 +
                    (SH_C3[2] * y * (4 * zz - xx - yy)) * splat.sh11 +
                    (SH_C3[3] * z * (2 * zz - 3 * xx - 3 * yy)) * splat.sh12 +
                    (SH_C3[4] * x * (4 * zz - xx - yy)) * splat.sh13 +
                    (SH_C3[5] * z * (xx - yy)) * splat.sh14 +
                    (SH_C3[6] * x * (xx - 3 * yy)) * splat.sh15;
            }
        }
    }
    return max(res, 0);
}

static const uint kTexWidth = 2048;

uint3 SplatIndexToPixelIndex(uint idx)
{
    uint3 res;

    uint2 xy = DecodeMorton2D_16x16(idx);
    uint width = kTexWidth / 16;
    idx >>= 8;
    res.x = (idx % width) * 16 + xy.x;
    res.y = (idx / width) * 16 + xy.y;
    res.z = 0;
    return res;
}

struct SplatChunkInfo
{
    uint colR, colG, colB, colA;
    float2 posX, posY, posZ;
    uint sclX, sclY, sclZ;
    uint shR, shG, shB;
};

StructuredBuffer<SplatChunkInfo> _SplatChunks;
uint _SplatChunkCount;

StructuredBuffer<uint> _SplatIndexRemap;
uint _UseSplatIndexRemap;

uint ResolveSplatIndex(uint idx)
{
    if (_UseSplatIndexRemap != 0)
        return _SplatIndexRemap[idx];
    return idx;
}

static const uint kChunkSize = 256;

struct SplatData
{
    float3 pos;
    float4 rot;
    float3 scale;
    half opacity;
    SplatSHData sh;
};

// Decode quaternion from a "smallest 3" e.g. 10.10.10.2 format
float4 DecodeRotation(float4 pq)
{
    uint idx = (uint)round(pq.w * 3.0); // note: need to round or index might come out wrong in some formats (e.g. fp16.fp16.fp16.fp16)
    float4 q;
    q.xyz = pq.xyz * sqrt(2.0) - (1.0 / sqrt(2.0));
    q.w = sqrt(1.0 - saturate(dot(q.xyz, q.xyz)));
    if (idx == 0) q = q.wxyz;
    if (idx == 1) q = q.xwyz;
    if (idx == 2) q = q.xywz;
    return q;
}
float4 PackSmallest3Rotation(float4 q)
{
    // find biggest component
    float4 absQ = abs(q);
    int index = 0;
    float maxV = absQ.x;
    if (absQ.y > maxV)
    {
        index = 1;
        maxV = absQ.y;
    }
    if (absQ.z > maxV)
    {
        index = 2;
        maxV = absQ.z;
    }
    if (absQ.w > maxV)
    {
        index = 3;
        maxV = absQ.w;
    }

    if (index == 0) q = q.yzwx;
    if (index == 1) q = q.xzwy;
    if (index == 2) q = q.xywz;

    float3 three = q.xyz * (q.w >= 0 ? 1 : -1); // -1/sqrt2..+1/sqrt2 range
    three = (three * sqrt(2.0)) * 0.5 + 0.5; // 0..1 range
    return float4(three, index / 3.0);
}

half3 DecodePacked_6_5_5(uint enc)
{
    return half3(
        (enc & 63) / 63.0,
        ((enc >> 6) & 31) / 31.0,
        ((enc >> 11) & 31) / 31.0);
}

half3 DecodePacked_5_6_5(uint enc)
{
    return half3(
        (enc & 31) / 31.0,
        ((enc >> 5) & 63) / 63.0,
        ((enc >> 11) & 31) / 31.0);
}

half3 DecodePacked_11_10_11(uint enc)
{
    return half3(
        (enc & 2047) / 2047.0,
        ((enc >> 11) & 1023) / 1023.0,
        ((enc >> 21) & 2047) / 2047.0);
}

float3 DecodePacked_16_16_16(uint2 enc)
{
    return float3(
        (enc.x & 65535) / 65535.0,
        ((enc.x >> 16) & 65535) / 65535.0,
        (enc.y & 65535) / 65535.0);
}

float4 DecodePacked_10_10_10_2(uint enc)
{
    return float4(
        (enc & 1023) / 1023.0,
        ((enc >> 10) & 1023) / 1023.0,
        ((enc >> 20) & 1023) / 1023.0,
        ((enc >> 30) & 3) / 3.0);
}
uint EncodeQuatToNorm10(float4 v) // 32 bits: 10.10.10.2
{
    return (uint) (v.x * 1023.5f) | ((uint) (v.y * 1023.5f) << 10) | ((uint) (v.z * 1023.5f) << 20) | ((uint) (v.w * 3.5f) << 30);
}


#ifdef SHADER_STAGE_COMPUTE
#define SplatBufferDataType RWByteAddressBuffer
#else
#define SplatBufferDataType ByteAddressBuffer
#endif

SplatBufferDataType _SplatPos;
SplatBufferDataType _SplatOther;
SplatBufferDataType _SplatSH;
Texture2D _SplatColor;
uint _SplatFormat;
uint _SplatSHDataValid;

// Match GaussianSplatAsset.VectorFormat
#define VECTOR_FMT_32F 0
#define VECTOR_FMT_16 1
#define VECTOR_FMT_11 2
#define VECTOR_FMT_6 3

uint LoadUShort(SplatBufferDataType dataBuffer, uint addrU)
{
    uint addrA = addrU & ~0x3;
    uint val = dataBuffer.Load(addrA);
    if (addrU != addrA)
        val >>= 16;
    return val & 0xFFFF;
}

uint LoadUInt(SplatBufferDataType dataBuffer, uint addrU)
{
    uint addrA = addrU & ~0x3;
    uint val = dataBuffer.Load(addrA);
    if (addrU != addrA)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        val = (val >> 16) | ((val1 & 0xFFFF) << 16);
    }
    return val;
}

float3 LoadAndDecodeVector(SplatBufferDataType dataBuffer, uint addrU, uint fmt)
{
    uint addrA = addrU & ~0x3;

    uint val0 = dataBuffer.Load(addrA);

    float3 res = 0;
    if (fmt == VECTOR_FMT_32F)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        uint val2 = dataBuffer.Load(addrA + 8);
        if (addrU != addrA)
        {
            uint val3 = dataBuffer.Load(addrA + 12);
            val0 = (val0 >> 16) | ((val1 & 0xFFFF) << 16);
            val1 = (val1 >> 16) | ((val2 & 0xFFFF) << 16);
            val2 = (val2 >> 16) | ((val3 & 0xFFFF) << 16);
        }
        res = float3(asfloat(val0), asfloat(val1), asfloat(val2));
    }
    else if (fmt == VECTOR_FMT_16)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        if (addrU != addrA)
        {
            val0 = (val0 >> 16) | ((val1 & 0xFFFF) << 16);
            val1 >>= 16;
        }
        res = DecodePacked_16_16_16(uint2(val0, val1));
    }
    else if (fmt == VECTOR_FMT_11)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        if (addrU != addrA)
        {
            val0 = (val0 >> 16) | ((val1 & 0xFFFF) << 16);
        }
        res = DecodePacked_11_10_11(val0);
    }
    else if (fmt == VECTOR_FMT_6)
    {
        if (addrU != addrA)
            val0 >>= 16;
        res = DecodePacked_6_5_5(val0);
    }
    return res;
}

float3 LoadSplatPosValue(uint index)
{
    uint fmt = _SplatFormat & 0xFF;
    uint stride = 0;
    if (fmt == VECTOR_FMT_32F)
        stride = 12;
    else if (fmt == VECTOR_FMT_16)
        stride = 6;
    else if (fmt == VECTOR_FMT_11)
        stride = 4;
    else if (fmt == VECTOR_FMT_6)
        stride = 2;
    return LoadAndDecodeVector(_SplatPos, index * stride, fmt);
}

float3 LoadSplatPos(uint idx)
{
    uint dataIdx = ResolveSplatIndex(idx);
    float3 pos = LoadSplatPosValue(dataIdx);
    uint chunkIdx = dataIdx / kChunkSize;
    if (chunkIdx < _SplatChunkCount)
    {
        SplatChunkInfo chunk = _SplatChunks[chunkIdx];
        float3 posMin = float3(chunk.posX.x, chunk.posY.x, chunk.posZ.x);
        float3 posMax = float3(chunk.posX.y, chunk.posY.y, chunk.posZ.y);
        pos = lerp(posMin, posMax, pos);
    }
    return pos;
}

half4 LoadSplatColTex(uint3 coord)
{
    return _SplatColor.Load(coord);
}

SplatData LoadSplatData(uint idx)
{
    idx = ResolveSplatIndex(idx);
    SplatData s = (SplatData)0;

    // figure out raw data offsets / locations
    uint3 coord = SplatIndexToPixelIndex(idx);

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;

    uint otherStride = 4; // rotation is 10.10.10.2
    if (scaleFmt == VECTOR_FMT_32F)
        otherStride += 12;
    else if (scaleFmt == VECTOR_FMT_16)
        otherStride += 6;
    else if (scaleFmt == VECTOR_FMT_11)
        otherStride += 4;
    else if (scaleFmt == VECTOR_FMT_6)
        otherStride += 2;
    if (shFormat > VECTOR_FMT_6)
        otherStride += 2;
    uint otherAddr = idx * otherStride;

    uint shStride = 0;
    if (shFormat == VECTOR_FMT_32F)
        shStride = 192; // 15*3 fp32, rounded up to multiple of 16
    else if (shFormat == VECTOR_FMT_16 || shFormat > VECTOR_FMT_6)
        shStride = 96; // 15*3 fp16, rounded up to multiple of 16
    else if (shFormat == VECTOR_FMT_11)
        shStride = 60; // 15x uint
    else if (shFormat == VECTOR_FMT_6)
        shStride = 32; // 15x ushort, rounded up to multiple of 4


    // load raw splat data, which might be chunk-relative
    s.pos       = LoadSplatPosValue(idx);
    s.rot       = DecodeRotation(DecodePacked_10_10_10_2(LoadUInt(_SplatOther, otherAddr)));
    s.scale     = LoadAndDecodeVector(_SplatOther, otherAddr + 4, scaleFmt);
    half4 col   = LoadSplatColTex(coord);

    if (_SplatSHDataValid != 0)
    {
        uint shIndex = idx;
        if (shFormat > VECTOR_FMT_6)
            shIndex = LoadUShort(_SplatOther, otherAddr + otherStride - 2);

        uint shOffset = shIndex * shStride;
        uint4 shRaw0 = _SplatSH.Load4(shOffset);
        uint4 shRaw1 = _SplatSH.Load4(shOffset + 16);
        if (shFormat == VECTOR_FMT_32F)
        {
        uint4 shRaw2 = _SplatSH.Load4(shOffset + 32);
        uint4 shRaw3 = _SplatSH.Load4(shOffset + 48);
        uint4 shRaw4 = _SplatSH.Load4(shOffset + 64);
        uint4 shRaw5 = _SplatSH.Load4(shOffset + 80);
        uint4 shRaw6 = _SplatSH.Load4(shOffset + 96);
        uint4 shRaw7 = _SplatSH.Load4(shOffset + 112);
        uint4 shRaw8 = _SplatSH.Load4(shOffset + 128);
        uint4 shRaw9 = _SplatSH.Load4(shOffset + 144);
        uint4 shRawA = _SplatSH.Load4(shOffset + 160);
        uint  shRawB = _SplatSH.Load(shOffset + 176);
        s.sh.sh1.r  = asfloat(shRaw0.x); s.sh.sh1.g =  asfloat(shRaw0.y); s.sh.sh1.b =  asfloat(shRaw0.z);
        s.sh.sh2.r  = asfloat(shRaw0.w); s.sh.sh2.g =  asfloat(shRaw1.x); s.sh.sh2.b =  asfloat(shRaw1.y);
        s.sh.sh3.r  = asfloat(shRaw1.z); s.sh.sh3.g =  asfloat(shRaw1.w); s.sh.sh3.b =  asfloat(shRaw2.x);
        s.sh.sh4.r  = asfloat(shRaw2.y); s.sh.sh4.g =  asfloat(shRaw2.z); s.sh.sh4.b =  asfloat(shRaw2.w);
        s.sh.sh5.r  = asfloat(shRaw3.x); s.sh.sh5.g =  asfloat(shRaw3.y); s.sh.sh5.b =  asfloat(shRaw3.z);
        s.sh.sh6.r  = asfloat(shRaw3.w); s.sh.sh6.g =  asfloat(shRaw4.x); s.sh.sh6.b =  asfloat(shRaw4.y);
        s.sh.sh7.r  = asfloat(shRaw4.z); s.sh.sh7.g =  asfloat(shRaw4.w); s.sh.sh7.b =  asfloat(shRaw5.x);
        s.sh.sh8.r  = asfloat(shRaw5.y); s.sh.sh8.g =  asfloat(shRaw5.z); s.sh.sh8.b =  asfloat(shRaw5.w);
        s.sh.sh9.r  = asfloat(shRaw6.x); s.sh.sh9.g =  asfloat(shRaw6.y); s.sh.sh9.b =  asfloat(shRaw6.z);
        s.sh.sh10.r = asfloat(shRaw6.w); s.sh.sh10.g = asfloat(shRaw7.x); s.sh.sh10.b = asfloat(shRaw7.y);
        s.sh.sh11.r = asfloat(shRaw7.z); s.sh.sh11.g = asfloat(shRaw7.w); s.sh.sh11.b = asfloat(shRaw8.x);
        s.sh.sh12.r = asfloat(shRaw8.y); s.sh.sh12.g = asfloat(shRaw8.z); s.sh.sh12.b = asfloat(shRaw8.w);
        s.sh.sh13.r = asfloat(shRaw9.x); s.sh.sh13.g = asfloat(shRaw9.y); s.sh.sh13.b = asfloat(shRaw9.z);
        s.sh.sh14.r = asfloat(shRaw9.w); s.sh.sh14.g = asfloat(shRawA.x); s.sh.sh14.b = asfloat(shRawA.y);
        s.sh.sh15.r = asfloat(shRawA.z); s.sh.sh15.g = asfloat(shRawA.w); s.sh.sh15.b = asfloat(shRawB);
        }
        else if (shFormat == VECTOR_FMT_16 || shFormat > VECTOR_FMT_6)
        {
        uint4 shRaw2 = _SplatSH.Load4(shOffset + 32);
        uint4 shRaw3 = _SplatSH.Load4(shOffset + 48);
        uint4 shRaw4 = _SplatSH.Load4(shOffset + 64);
        uint3 shRaw5 = _SplatSH.Load3(shOffset + 80);
        s.sh.sh1.r  = f16tof32(shRaw0.x      ); s.sh.sh1.g =  f16tof32(shRaw0.x >> 16); s.sh.sh1.b =  f16tof32(shRaw0.y      );
        s.sh.sh2.r  = f16tof32(shRaw0.y >> 16); s.sh.sh2.g =  f16tof32(shRaw0.z      ); s.sh.sh2.b =  f16tof32(shRaw0.z >> 16);
        s.sh.sh3.r  = f16tof32(shRaw0.w      ); s.sh.sh3.g =  f16tof32(shRaw0.w >> 16); s.sh.sh3.b =  f16tof32(shRaw1.x      );
        s.sh.sh4.r  = f16tof32(shRaw1.x >> 16); s.sh.sh4.g =  f16tof32(shRaw1.y      ); s.sh.sh4.b =  f16tof32(shRaw1.y >> 16);
        s.sh.sh5.r  = f16tof32(shRaw1.z      ); s.sh.sh5.g =  f16tof32(shRaw1.z >> 16); s.sh.sh5.b =  f16tof32(shRaw1.w      );
        s.sh.sh6.r  = f16tof32(shRaw1.w >> 16); s.sh.sh6.g =  f16tof32(shRaw2.x      ); s.sh.sh6.b =  f16tof32(shRaw2.x >> 16);
        s.sh.sh7.r  = f16tof32(shRaw2.y      ); s.sh.sh7.g =  f16tof32(shRaw2.y >> 16); s.sh.sh7.b =  f16tof32(shRaw2.z      );
        s.sh.sh8.r  = f16tof32(shRaw2.z >> 16); s.sh.sh8.g =  f16tof32(shRaw2.w      ); s.sh.sh8.b =  f16tof32(shRaw2.w >> 16);
        s.sh.sh9.r  = f16tof32(shRaw3.x      ); s.sh.sh9.g =  f16tof32(shRaw3.x >> 16); s.sh.sh9.b =  f16tof32(shRaw3.y      );
        s.sh.sh10.r = f16tof32(shRaw3.y >> 16); s.sh.sh10.g = f16tof32(shRaw3.z      ); s.sh.sh10.b = f16tof32(shRaw3.z >> 16);
        s.sh.sh11.r = f16tof32(shRaw3.w      ); s.sh.sh11.g = f16tof32(shRaw3.w >> 16); s.sh.sh11.b = f16tof32(shRaw4.x      );
        s.sh.sh12.r = f16tof32(shRaw4.x >> 16); s.sh.sh12.g = f16tof32(shRaw4.y      ); s.sh.sh12.b = f16tof32(shRaw4.y >> 16);
        s.sh.sh13.r = f16tof32(shRaw4.z      ); s.sh.sh13.g = f16tof32(shRaw4.z >> 16); s.sh.sh13.b = f16tof32(shRaw4.w      );
        s.sh.sh14.r = f16tof32(shRaw4.w >> 16); s.sh.sh14.g = f16tof32(shRaw5.x      ); s.sh.sh14.b = f16tof32(shRaw5.x >> 16);
        s.sh.sh15.r = f16tof32(shRaw5.y      ); s.sh.sh15.g = f16tof32(shRaw5.y >> 16); s.sh.sh15.b = f16tof32(shRaw5.z      );
        }
        else if (shFormat == VECTOR_FMT_11)
        {
        uint4 shRaw2 = _SplatSH.Load4(shOffset + 32);
        uint3 shRaw3 = _SplatSH.Load3(shOffset + 48);
        s.sh.sh1 =  DecodePacked_11_10_11(shRaw0.x);
        s.sh.sh2 =  DecodePacked_11_10_11(shRaw0.y);
        s.sh.sh3 =  DecodePacked_11_10_11(shRaw0.z);
        s.sh.sh4 =  DecodePacked_11_10_11(shRaw0.w);
        s.sh.sh5 =  DecodePacked_11_10_11(shRaw1.x);
        s.sh.sh6 =  DecodePacked_11_10_11(shRaw1.y);
        s.sh.sh7 =  DecodePacked_11_10_11(shRaw1.z);
        s.sh.sh8 =  DecodePacked_11_10_11(shRaw1.w);
        s.sh.sh9 =  DecodePacked_11_10_11(shRaw2.x);
        s.sh.sh10 = DecodePacked_11_10_11(shRaw2.y);
        s.sh.sh11 = DecodePacked_11_10_11(shRaw2.z);
        s.sh.sh12 = DecodePacked_11_10_11(shRaw2.w);
        s.sh.sh13 = DecodePacked_11_10_11(shRaw3.x);
        s.sh.sh14 = DecodePacked_11_10_11(shRaw3.y);
        s.sh.sh15 = DecodePacked_11_10_11(shRaw3.z);
        }
        else if (shFormat == VECTOR_FMT_6)
        {
        s.sh.sh1 =  DecodePacked_5_6_5(shRaw0.x);
        s.sh.sh2 =  DecodePacked_5_6_5(shRaw0.x >> 16);
        s.sh.sh3 =  DecodePacked_5_6_5(shRaw0.y);
        s.sh.sh4 =  DecodePacked_5_6_5(shRaw0.y >> 16);
        s.sh.sh5 =  DecodePacked_5_6_5(shRaw0.z);
        s.sh.sh6 =  DecodePacked_5_6_5(shRaw0.z >> 16);
        s.sh.sh7 =  DecodePacked_5_6_5(shRaw0.w);
        s.sh.sh8 =  DecodePacked_5_6_5(shRaw0.w >> 16);
        s.sh.sh9 =  DecodePacked_5_6_5(shRaw1.x);
        s.sh.sh10 = DecodePacked_5_6_5(shRaw1.x >> 16);
        s.sh.sh11 = DecodePacked_5_6_5(shRaw1.y);
        s.sh.sh12 = DecodePacked_5_6_5(shRaw1.y >> 16);
        s.sh.sh13 = DecodePacked_5_6_5(shRaw1.z);
        s.sh.sh14 = DecodePacked_5_6_5(shRaw1.z >> 16);
            s.sh.sh15 = DecodePacked_5_6_5(shRaw1.w);
        }
    }

    // if raw data is chunk-relative, convert to final values by interpolating between chunk min/max
    uint chunkIdx = idx / kChunkSize;
    if (chunkIdx < _SplatChunkCount)
    {
        SplatChunkInfo chunk = _SplatChunks[chunkIdx];
        float3 posMin = float3(chunk.posX.x, chunk.posY.x, chunk.posZ.x);
        float3 posMax = float3(chunk.posX.y, chunk.posY.y, chunk.posZ.y);
        half3 sclMin = half3(f16tof32(chunk.sclX    ), f16tof32(chunk.sclY    ), f16tof32(chunk.sclZ    ));
        half3 sclMax = half3(f16tof32(chunk.sclX>>16), f16tof32(chunk.sclY>>16), f16tof32(chunk.sclZ>>16));
        half4 colMin = half4(f16tof32(chunk.colR    ), f16tof32(chunk.colG    ), f16tof32(chunk.colB    ), f16tof32(chunk.colA    ));
        half4 colMax = half4(f16tof32(chunk.colR>>16), f16tof32(chunk.colG>>16), f16tof32(chunk.colB>>16), f16tof32(chunk.colA>>16));
        half3 shMin = half3(f16tof32(chunk.shR    ), f16tof32(chunk.shG    ), f16tof32(chunk.shB    ));
        half3 shMax = half3(f16tof32(chunk.shR>>16), f16tof32(chunk.shG>>16), f16tof32(chunk.shB>>16));
        s.pos = lerp(posMin, posMax, s.pos);
        s.scale     = lerp(sclMin, sclMax, s.scale);
        s.scale *= s.scale;
        s.scale *= s.scale;
        s.scale *= s.scale;
        col   = lerp(colMin, colMax, col);
        col.a = InvSquareCentered01(col.a);

        if (_SplatSHDataValid != 0 && shFormat > VECTOR_FMT_32F && shFormat <= VECTOR_FMT_6)
        {
            s.sh.sh1    = lerp(shMin, shMax, s.sh.sh1 );
            s.sh.sh2    = lerp(shMin, shMax, s.sh.sh2 );
            s.sh.sh3    = lerp(shMin, shMax, s.sh.sh3 );
            s.sh.sh4    = lerp(shMin, shMax, s.sh.sh4 );
            s.sh.sh5    = lerp(shMin, shMax, s.sh.sh5 );
            s.sh.sh6    = lerp(shMin, shMax, s.sh.sh6 );
            s.sh.sh7    = lerp(shMin, shMax, s.sh.sh7 );
            s.sh.sh8    = lerp(shMin, shMax, s.sh.sh8 );
            s.sh.sh9    = lerp(shMin, shMax, s.sh.sh9 );
            s.sh.sh10   = lerp(shMin, shMax, s.sh.sh10);
            s.sh.sh11   = lerp(shMin, shMax, s.sh.sh11);
            s.sh.sh12   = lerp(shMin, shMax, s.sh.sh12);
            s.sh.sh13   = lerp(shMin, shMax, s.sh.sh13);
            s.sh.sh14   = lerp(shMin, shMax, s.sh.sh14);
            s.sh.sh15   = lerp(shMin, shMax, s.sh.sh15);
        }
    }
    s.opacity   = col.a;
    s.sh.col    = col.rgb;

    return s;
}

struct SplatViewData
{
    float4 pos;
    uint axis1, axis2; // screen-space conic axes, each packed as half2 (f16 x in high 16 bits, y in low)
    uint2 color; // 4xFP16
    // Keep this as float4 so the StructuredBuffer stride remains 16-byte aligned on Vulkan/Adreno.
    // A 44-byte stride with float3 worked on desktop but caused unstable reads / flickering on Quest.
    float4 worldPos; // xyz = stable world-space splat center (from compute)
};

#endif // GAUSSIAN_SPLATTING_HLSL

float4x4 _MatrixObjectToWorld;
float4x4 _MatrixWorldToObject;
float4x4 _MatrixVP;
float4x4 _MatrixMV;
float4x4 _MatrixP;
float4 _VecScreenParams;
float4 _VecWorldSpaceCameraPos;
int _SelectionMode;

// Distance culling variables
int _EnableDistanceCulling;
float _KillRadius;
float3 _CullOrigin;

// Wind system variables
struct WindBoxData
{
    float4x4 worldToBox;
    float3 windDirection;
    float windStrength;
    float noiseStrength;
    float noiseScale;
    float noiseSpeed;
    uint flags; // bit 0: enabled, bit 1: invert, bit 2: restore position, bit 3: turbulence only
    float3 boxCenter;
    float restoreSpeed;
    float restoreStrength;
    float individualVariation;
    float windStrengthThreshold; // Minimum strength before effects activate
    float turbulenceSpread; // Controls distance/spacing between splats in turbulence field
};

StructuredBuffer<WindBoxData> _WindBoxes;
uint _WindBoxCount;
float _WindTime;

// Attractor system - simplified
struct AttractorData
{
    float3 position;
    float strength;
    float range;
    float falloff;
    int mode;       // 0=Vortex, 1=Attract, 2=Repel, 3=Wave
    float enabled;
    float vortexHeight;
    float waveFrequency;
    float waveAmplitude;
    float waveSpeed;
    int waveAxis;   // 0=X, 1=Y, 2=Z
    float curlStrength;
    float secondaryFrequency;
    float4 rotation;
    float3 scale;
    float scalePadding;
};

StructuredBuffer<AttractorData> _Attractors;
uint _AttractorCount;

// Per-splat animation flags (bit 0: no gravity, bit 1-7: reserved)
RWByteAddressBuffer _SplatAnimFlags;

RWStructuredBuffer<uint> _SplatSortDistances;
RWStructuredBuffer<uint> _SplatSortKeys;
uint _SplatCount;
uint _SortByCameraDistance;
// Deterministic stable-sort controls (mobile). When _StableSort != 0 the sort key is a composite of
// quantized depth in the high bits and the splat index in the low bits, guaranteeing unique keys.
uint _StableSort;
uint _SortIndexBits;   // number of low bits reserved for the splat index
float _SortDepthScale; // 1 / max sort depth (maps camera depth -> [0,1])
// Number of significant key bits to emit. 16 = quantized depth packed into the low 16 bits (high bits
// zero) so the radix sorter only needs 2 passes instead of 4 (~2x faster on mobile). Anything else =
// full 32-bit float key. Ignored on the deterministic stable path, which always uses a 32-bit key.
uint _SortKeyBits;

// radix sort etc. friendly, see http://stereopsis.com/radix.html
uint FloatToSortableUint(float f)
{
    uint fu = asuint(f);
    uint mask = -((int)(fu >> 31)) | 0x80000000;
    return fu ^ mask;
}

float SortableUintToFloat(uint u)
{
    // Inverse of FloatToSortableUint (see http://stereopsis.com/radix.html)
    uint mask = (((int)(u >> 31)) - 1) | 0x80000000;
    return asfloat(u ^ mask);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSetIndices (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    _SplatSortKeys[idx] = idx;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcDistances (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    // Re-seed the index buffer to a full identity permutation every frame instead of re-sorting
    // the previous frame's order (origIdx = _SplatSortKeys[idx]). The in-place re-sort relies on
    // the GPU radix sort being a perfect permutation EVERY frame; on some mobile/Vulkan GPUs
    // (Quest/Adreno) it occasionally drops or duplicates a value, and because the next frame starts
    // from that corrupted order the error is permanent and compounds, so splats slowly vanish over
    // time (Android-only; desktop sorts are bit-exact so it never shows there). Sorting from a fresh
    // identity each frame costs the same and is self-healing.
    _SplatSortKeys[idx] = idx;

    float3 pos = LoadSplatPos(idx);
    float sortDistance;
    if (_SortByCameraDistance != 0)
    {
        float3 worldPos = mul(_MatrixObjectToWorld, float4(pos.xyz, 1)).xyz;
        float3 toCamera = worldPos - _VecWorldSpaceCameraPos.xyz;
        // Stable path and the 16-bit quantized path both need a linear (metric) depth so the buckets are
        // uniform in meters; the default full-precision fast path keeps squared distance (monotonic, one
        // fewer sqrt).
        sortDistance = (_StableSort != 0 || _SortKeyBits == 16u) ? length(toCamera) : dot(toCamera, toCamera);
    }
    else
    {
        pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;
        sortDistance = pos.z;
    }

    if (_StableSort != 0)
    {
        // Build a deterministic total order: quantized depth in the high bits, splat index in the low
        // bits. Because the index makes every key unique, equal-depth splats can no longer swap order
        // between frames, which removes the flicker / "extra layer" churn on GPUs whose radix sort is
        // not stable. Ascending sort stays near->far to match the front-to-back blend.
        uint indexBits = min(_SortIndexBits, 31u);
        uint depthBits = 32u - indexBits;
        uint maxDepthVal = (depthBits >= 32u) ? 0xFFFFFFFFu : ((1u << depthBits) - 1u);
        uint indexMask = (indexBits >= 32u) ? 0xFFFFFFFFu : ((1u << indexBits) - 1u);
        float nd = saturate(sortDistance * _SortDepthScale);
        uint dq = (uint)(nd * (float)maxDepthVal + 0.5);
        dq = min(dq, maxDepthVal);
        _SplatSortDistances[idx] = (dq << indexBits) | (idx & indexMask);
    }
    else if (_SortKeyBits == 16u)
    {
        // Quantize linear depth into the LOW 16 bits (high 16 bits stay zero). The radix sorter then only
        // runs 2 of its 4 passes. 65536 depth buckets is far finer than any visible transparency error.
        // Ascending sort stays near->far to match the front-to-back blend.
        float nd = saturate(sortDistance * _SortDepthScale);
        uint dq = (uint)(nd * 65535.0 + 0.5);
        _SplatSortDistances[idx] = min(dq, 65535u);
    }
    else
    {
        _SplatSortDistances[idx] = FloatToSortableUint(sortDistance);
    }
}

RWStructuredBuffer<SplatViewData> _SplatViewData;

float _SplatScale;
float _SplatOpacityScale;
uint _SHOrder;
uint _SHOnly;
uint _AlbedoOnly;

// Mobile (Quest/Adreno) SH evaluation cap. The degree-3 band is 7 of the 15 SH coefficients and the
// heaviest polynomial in ShadeSH, yet it only adds subtle view-dependent detail. Clamping the evaluated
// order on mobile is a large per-splat ALU saving for a minor color-accuracy loss. Set to 3 to disable.
#ifndef GS_MOBILE_MAX_SH_ORDER
#define GS_MOBILE_MAX_SH_ORDER 2
#endif

uint _SplatCutoutsCount;

#define SPLAT_CUTOUT_TYPE_ELLIPSOID 0
#define SPLAT_CUTOUT_TYPE_BOX 1
#define SPLAT_CUTOUT_TYPE_POLYGON 2

struct GaussianCutoutShaderData // match GaussianCutout.ShaderData in C#
{
    float4x4 mat;
    uint typeAndFlags;
    float expansionX;
    float expansionY;
    float cutDepth;
    uint extrusionAxis;  // 0=auto/Z, 1=X, 2=Y, 3=Z
    float offsetX;
    float offsetY;
};
StructuredBuffer<GaussianCutoutShaderData> _SplatCutouts;

RWByteAddressBuffer _SplatSelectedBits;
RWByteAddressBuffer _SplatDeletedBits;
uint _SplatBitsValid;

void DecomposeCovariance(float3 cov2d, out float2 v1, out float2 v2)
{
    #if 0 // does not quite give the correct results?

    // https://jsfiddle.net/mattrossman/ehxmtgw6/
    // References:
    // - https://www.youtube.com/watch?v=e50Bj7jn9IQ
    // - https://en.wikipedia.org/wiki/Eigenvalue_algorithm#2%C3%972_matrices
    // - https://people.math.harvard.edu/~knill/teaching/math21b2004/exhibits/2dmatrices/index.html
    float a = cov2d.x;
    float b = cov2d.y;
    float d = cov2d.z;
    float det = a * d - b * b; // matrix is symmetric, so "c" is same as "b"
    float trace = a + d;

    float mean = 0.5 * trace;
    float dist = sqrt(mean * mean - det);

    float lambda1 = mean + dist; // 1st eigenvalue
    float lambda2 = mean - dist; // 2nd eigenvalue

    if (b == 0) {
        // https://twitter.com/the_ross_man/status/1706342719776551360
        if (a > d) v1 = float2(1, 0);
        else v1 = float2(0, 1);
    } else
        v1 = normalize(float2(b, d - lambda2));

    v1.y = -v1.y;
    // The 2nd eigenvector is just a 90 degree rotation of the first since Gaussian axes are orthogonal
    v2 = float2(v1.y, -v1.x);

    // scaling components
    v1 *= sqrt(lambda1);
    v2 *= sqrt(lambda2);

    float radius = 1.5;
    v1 *= radius;
    v2 *= radius;

    #else

    // same as in antimatter15/splat
    float diag1 = cov2d.x, diag2 = cov2d.z, offDiag = cov2d.y;
    float mid = 0.5f * (diag1 + diag2);
    float radius = length(float2((diag1 - diag2) / 2.0, offDiag));
    float lambda1 = mid + radius;
    float lambda2 = max(mid - radius, 0.1);
    float2 diagVec = normalize(float2(offDiag, lambda1 - diag1));
    diagVec.y = -diagVec.y;
    float maxSize = 4096.0;
    v1 = min(sqrt(2.0 * lambda1), maxSize) * diagVec;
    v2 = min(sqrt(2.0 * lambda2), maxSize) * float2(diagVec.y, -diagVec.x);

    #endif
}

bool IsSplatCut(float3 pos)
{
    bool finalCut = false;
    for (uint i = 0; i < _SplatCutoutsCount; ++i)
    {
        GaussianCutoutShaderData cutData = _SplatCutouts[i];
        uint type = cutData.typeAndFlags & 0xFF;
        if (type == 0xFF) // invalid/null cutout, ignore
            continue;
        bool invert = (cutData.typeAndFlags & 0xFF00) != 0;

        float3 cutoutPos = mul(cutData.mat, float4(pos, 1)).xyz;
        if (type == SPLAT_CUTOUT_TYPE_ELLIPSOID)
        {
            if (dot(cutoutPos, cutoutPos) <= 1) return !invert;  // Delete if inside and not inverted
            if (invert) return true;  // Delete if outside and inverted
        }
        if (type == SPLAT_CUTOUT_TYPE_BOX)
        {
            if (all(abs(cutoutPos) <= 1)) return !invert;  // Delete if inside and not inverted
            if (invert) return true;  // Delete if outside and inverted
        }
        if (type == SPLAT_CUTOUT_TYPE_POLYGON)
        {
            // 2D bounds test for polygon with configurable extrusion depth
            // Extrusion axis determines which 2 axes define the polygon plane
            // extrusionAxis: 0/3=Z (XY plane), 1=X (YZ plane), 2=Y (XZ plane)
            float expX = cutData.expansionX > 0.01 ? cutData.expansionX : 1.0;
            float expY = cutData.expansionY > 0.01 ? cutData.expansionY : 1.0;
            float depth = cutData.cutDepth > 0.01 ? cutData.cutDepth : 100.0;
            float offX = cutData.offsetX;
            float offY = cutData.offsetY;
            
            uint axis = cutData.extrusionAxis;
            bool insideBounds = false;
            
            if (axis == 1)  // Extrude through X (YZ polygon plane)
            {
                insideBounds = abs(cutoutPos.y - offX) <= expX && abs(cutoutPos.z - offY) <= expY && abs(cutoutPos.x) <= depth;
            }
            else if (axis == 2)  // Extrude through Y (XZ polygon plane)
            {
                insideBounds = abs(cutoutPos.x - offX) <= expX && abs(cutoutPos.z - offY) <= expY && abs(cutoutPos.y) <= depth;
            }
            else  // axis == 0 or 3: Extrude through Z (XY polygon plane) - default
            {
                insideBounds = abs(cutoutPos.x - offX) <= expX && abs(cutoutPos.y - offY) <= expY && abs(cutoutPos.z) <= depth;
            }
            
            if (insideBounds)
            {
                return !invert;  // Delete if inside bounds
            }
            if (invert)
            {
                return true;  // Delete if outside bounds and inverted
            }
        }
    }
    return finalCut;
}

bool IsFiniteFloat(float v)
{
    return v == v && abs(v) < 1.0e20;
}

bool AllFinite2(float2 v)
{
    return IsFiniteFloat(v.x) && IsFiniteFloat(v.y);
}

bool AllFinite3(float3 v)
{
    return IsFiniteFloat(v.x) && IsFiniteFloat(v.y) && IsFiniteFloat(v.z);
}

bool AllFinite4(float4 v)
{
    return IsFiniteFloat(v.x) && IsFiniteFloat(v.y) && IsFiniteFloat(v.z) && IsFiniteFloat(v.w);
}

[numthreads(GROUP_SIZE,1,1)]
void CSCalcViewData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    SplatData splat = LoadSplatData(idx);
    SplatViewData view = (SplatViewData)0;
    
    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(splat.pos,1)).xyz;
    // Use explicit per-eye matrices from C# (_MatrixVP). UNITY_MATRIX_* is stale in compute on Quest XR.
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    half opacityScale = _SplatOpacityScale;
    float splatScale = _SplatScale;

    if (!AllFinite3(centerWorldPos) || !AllFinite4(centerClipPos))
    {
        view.pos = 0;
        _SplatViewData[idx] = view;
        return;
    }

    // deleted?
    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1 << bitIdx))
        {
            centerClipPos.w = 0;
        }
    }

    // cutouts
    if (IsSplatCut(splat.pos))
    {
        centerClipPos.w = 0;
    }

    // distance culling - delete splats beyond kill radius
    if (_EnableDistanceCulling != 0)
    {
        float distanceFromOrigin = length(centerWorldPos - _CullOrigin);
        if (distanceFromOrigin > _KillRadius)
        {
            centerClipPos.w = 0; // Hide the splat by setting w to 0
        }
    }

    // Very near-plane splats can project to enormous quads for a frame in VR as the head moves through
    // the capture. Hide them in compute (once/splat) instead of letting them appear as colorful blinking blobs.
    if (centerClipPos.w > 0 && centerClipPos.w < 0.02)
    {
        centerClipPos.w = 0;
    }

    view.pos = centerClipPos;
    view.worldPos = float4(centerWorldPos, 1);
    bool behindCam = centerClipPos.w <= 0;
    if (!behindCam)
    {
        float4 boxRot = splat.rot;
        float3 boxSize = splat.scale;

        float3x3 splatRotScaleMat = CalcMatrixFromRotationScale(boxRot, boxSize);

        float3 cov3d0, cov3d1;
        CalcCovariance3D(splatRotScaleMat, cov3d0, cov3d1);
        float splatScale2 = splatScale * splatScale;
        cov3d0 *= splatScale2;
        cov3d1 *= splatScale2;
        float3 cov2d = CalcCovariance2D(splat.pos, cov3d0, cov3d1, _MatrixMV, _MatrixP, _VecScreenParams);
        if (!AllFinite3(cov2d))
        {
            view.pos.w = 0;
            _SplatViewData[idx] = view;
            return;
        }
        
        float2 axisV1, axisV2;
        DecomposeCovariance(cov2d, axisV1, axisV2);
        // Discard pathological projections before they reach the vertex shader. This catches the rare
        // "extra colored splat" frames without paying per-vertex isnan/isinf costs.
        if (!AllFinite2(axisV1) || !AllFinite2(axisV2) ||
            dot(axisV1, axisV1) > (2048.0 * 2048.0) || dot(axisV2, axisV2) > (2048.0 * 2048.0))
        {
            view.pos.w = 0;
            _SplatViewData[idx] = view;
            return;
        }
        view.axis1 = (f32tof16(axisV1.x) << 16) | f32tof16(axisV1.y);
        view.axis2 = (f32tof16(axisV2.x) << 16) | f32tof16(axisV2.y);

        float3 worldViewDir = _VecWorldSpaceCameraPos.xyz - centerWorldPos;
        float viewLenSq = dot(worldViewDir, worldViewDir);
        float3 objViewDir = float3(0, 0, 1);
        if (viewLenSq > 1.0e-10 && viewLenSq < 1.0e20)
        {
            objViewDir = mul((float3x3)_MatrixWorldToObject, worldViewDir);
            objViewDir = normalize(objViewDir);
        }

        half4 col;
        if (_AlbedoOnly != 0)
            col.rgb = splat.sh.col;
        else
        {
            int shOrder = (int)_SHOrder;
            #if defined(SHADER_API_MOBILE)
            shOrder = min(shOrder, GS_MOBILE_MAX_SH_ORDER);
            #endif
            col.rgb = ShadeSH(splat.sh, objViewDir, shOrder, _SHOnly != 0);
        }
        col.a = min(splat.opacity * opacityScale, 65000);
        if (!AllFinite3(float3(col.r, col.g, col.b)) || !IsFiniteFloat(col.a))
        {
            view.pos.w = 0;
            _SplatViewData[idx] = view;
            return;
        }
        view.color.x = (f32tof16(col.r) << 16) | f32tof16(col.g);
        view.color.y = (f32tof16(col.b) << 16) | f32tof16(col.a);
    }
    
    _SplatViewData[idx] = view;
}


RWByteAddressBuffer _DstBuffer;
ByteAddressBuffer _SrcBuffer;
uint _BufferSize;

uint2 GetSplatIndicesFromWord(uint idx)
{
    uint idxStart = idx * 32;
    uint idxEnd = min(idxStart + 32, _SplatCount);
    return uint2(idxStart, idxEnd);
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdateEditData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;

    uint valSel = _SplatSelectedBits.Load(idx * 4);
    uint valDel = _SplatDeletedBits.Load(idx * 4);
    valSel &= ~valDel; // don't count deleted splats as selected
    uint2 splatIndices = GetSplatIndicesFromWord(idx);

    // update selection bounds
    float3 bmin = 1.0e38;
    float3 bmax = -1.0e38;
    uint mask = 1;
    uint valCut = 0;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        // don't count cut splats as selected
        if (IsSplatCut(spos))
        {
            valSel &= ~mask;
            valCut |= mask;
        }
        if (valSel & mask)
        {
            bmin = min(bmin, spos);
            bmax = max(bmax, spos);
        }
    }
    valCut &= ~valDel; // don't count deleted splats as cut

    if (valSel != 0)
    {
        _DstBuffer.InterlockedMin(12, FloatToSortableUint(bmin.x));
        _DstBuffer.InterlockedMin(16, FloatToSortableUint(bmin.y));
        _DstBuffer.InterlockedMin(20, FloatToSortableUint(bmin.z));
        _DstBuffer.InterlockedMax(24, FloatToSortableUint(bmax.x));
        _DstBuffer.InterlockedMax(28, FloatToSortableUint(bmax.y));
        _DstBuffer.InterlockedMax(32, FloatToSortableUint(bmax.z));
    }
    uint sumSel = countbits(valSel);
    uint sumDel = countbits(valDel);
    uint sumCut = countbits(valCut);
    _DstBuffer.InterlockedAdd(0, sumSel);
    _DstBuffer.InterlockedAdd(4, sumDel);
    _DstBuffer.InterlockedAdd(8, sumCut);
}

[numthreads(1,1,1)]
void CSInitEditData (uint3 id : SV_DispatchThreadID)
{
    _DstBuffer.Store3(0, uint3(0,0,0)); // selected, deleted, cut counts
    uint initMin = FloatToSortableUint(1.0e38);
    uint initMax = FloatToSortableUint(-1.0e38);
    _DstBuffer.Store3(12, uint3(initMin, initMin, initMin));
    _DstBuffer.Store3(24, uint3(initMax, initMax, initMax));
}

[numthreads(GROUP_SIZE,1,1)]
void CSClearBuffer (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    _DstBuffer.Store(idx * 4, 0);
}

[numthreads(GROUP_SIZE,1,1)]
void CSInvertSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = _DstBuffer.Load(idx * 4);
    v = ~v;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}

[numthreads(GROUP_SIZE,1,1)]
void CSSelectAll (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint v = ~0;

    // do not select splats that are cut
    uint2 splatIndices = GetSplatIndicesFromWord(idx);
    uint mask = 1;
    for (uint sidx = splatIndices.x; sidx < splatIndices.y; ++sidx, mask <<= 1)
    {
        float3 spos = LoadSplatPos(sidx);
        if (IsSplatCut(spos))
            v &= ~mask;
    }

    _DstBuffer.Store(idx * 4, v);
}


[numthreads(GROUP_SIZE,1,1)]
void CSOrBuffers (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _BufferSize)
        return;
    uint a = _SrcBuffer.Load(idx * 4);
    uint b = _DstBuffer.Load(idx * 4);
    _DstBuffer.Store(idx * 4, a | b);
}

float4 _SelectionRect;
float2 _SelectionCircleCenterPx;
float _SelectionCircleRadiusPx;
int _BackfaceCulling;
float _SelectionDepthEpsilon;
RWByteAddressBuffer _SelectionMinDepth;

[numthreads(GROUP_SIZE,1,1)]
void CSSelectionUpdate (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    bool behindCam = centerClipPos.w <= 0;
    if (behindCam)
        return;

    float2 pixelPos = (centerClipPos.xy / centerClipPos.w * float2(0.5, -0.5) + 0.5) * _VecScreenParams.xy;
    if (pixelPos.x < _SelectionRect.x || pixelPos.x > _SelectionRect.z ||
        pixelPos.y < _SelectionRect.y || pixelPos.y > _SelectionRect.w)
    {
        return;
    }
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx); // +
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx)); // -
}

// Paint selection in screen-space (circle in pixels)
// _SelectionCircleCenterPx is in GUI coordinates (Y=0 at top)
[numthreads(GROUP_SIZE,1,1)]
void CSSelectSplatsInScreenCircle (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    if (centerClipPos.w <= 0)
        return;

    // Convert clip space to pixel coordinates
    // Clip: X [-1,1] left to right, Y [-1,1] bottom to top
    // GUI coords: Y=0 at top, so we need Y inverted
    float2 ndc = centerClipPos.xy / centerClipPos.w;
    float2 pixelPos;
    pixelPos.x = (ndc.x * 0.5 + 0.5) * _VecScreenParams.x;
    pixelPos.y = (1.0 - (ndc.y * 0.5 + 0.5)) * _VecScreenParams.y; // Y flipped for GUI coords
    
    float2 d = pixelPos - _SelectionCircleCenterPx;
    if (dot(d, d) > (_SelectionCircleRadiusPx * _SelectionCircleRadiusPx))
        return;
    
    // "Visible only" culling: keep only the front depth layer under the cursor.
    // This filters out splats behind the visible surface (occluded by nearer splats).
    if (_BackfaceCulling)
    {
        uint minDepthSortable = _SelectionMinDepth.Load(0);
        float minDepth = SortableUintToFloat(minDepthSortable);
        if (centerClipPos.w > (minDepth + _SelectionDepthEpsilon))
            return;
    }

    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    if (_SelectionMode)
        _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx); // +
    else
        _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx)); // -
}

// First pass for "visible only" culling: find minimum view depth (centerClipPos.w) in the screen circle
[numthreads(GROUP_SIZE,1,1)]
void CSFindMinDepthInScreenCircle (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    if (centerClipPos.w <= 0)
        return;

    float2 ndc = centerClipPos.xy / centerClipPos.w;
    float2 pixelPos;
    pixelPos.x = (ndc.x * 0.5 + 0.5) * _VecScreenParams.x;
    pixelPos.y = (1.0 - (ndc.y * 0.5 + 0.5)) * _VecScreenParams.y;

    float2 d = pixelPos - _SelectionCircleCenterPx;
    if (dot(d, d) > (_SelectionCircleRadiusPx * _SelectionCircleRadiusPx))
        return;

    // centerClipPos.w is view-space depth for standard perspective
    _SelectionMinDepth.InterlockedMin(0, FloatToSortableUint(centerClipPos.w));
}

float3 _SelectionDelta;

bool IsSplatSelected(uint idx)
{
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    uint selVal = _SplatSelectedBits.Load(wordIdx * 4);
    return (selVal & (1 << bitIdx)) != 0;
}

[numthreads(GROUP_SIZE,1,1)]
void CSTranslateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPos.Load3(idx * stride));
        pos += _SelectionDelta;
        _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(pos));
    }
}

float3 _SelectionCenter;
float4 _SelectionDeltaRot;
ByteAddressBuffer _SplatPosMouseDown;
ByteAddressBuffer _SplatOtherMouseDown;

[numthreads(GROUP_SIZE,1,1)]
void CSRotateSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint posFmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && posFmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * posStride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos = QuatRotateVector(pos, _SelectionDeltaRot);
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(pos));
    }

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    if (_SplatChunkCount == 0 && scaleFmt == VECTOR_FMT_32F && shFormat == VECTOR_FMT_32F)
    {
        uint otherStride = 4 + 12;
        uint rotVal = _SplatOtherMouseDown.Load(idx * otherStride);
        float4 rot = DecodeRotation(DecodePacked_10_10_10_2(rotVal));

        //@TODO: correct rotation
        rot = QuatMul(rot, _SelectionDeltaRot);

        rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(rot));
        _SplatOther.Store(idx * otherStride, rotVal);
    }

    //@TODO: rotate SHs
}

//@TODO: maybe scale the splat scale itself too?
[numthreads(GROUP_SIZE,1,1)]
void CSScaleSelection (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    if (!IsSplatSelected(idx))
        return;

    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint stride = 12;
        float3 pos = asfloat(_SplatPosMouseDown.Load3(idx * stride));
        pos -= _SelectionCenter;
        pos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
        pos *= _SelectionDelta;
        pos = mul(_MatrixWorldToObject, float4(pos,1)).xyz;
        pos += _SelectionCenter;
        _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(pos));
    }
}

struct ExportSplatData
{
    float3 pos;
    float3 nor;
    float3 dc0;
    float4 shR14; float4 shR58; float4 shR9C; float3 shRDF;
    float4 shG14; float4 shG58; float4 shG9C; float3 shGDF;
    float4 shB14; float4 shB58; float4 shB9C; float3 shBDF;
    float opacity;
    float3 scale;
    float4 rot;
};
RWStructuredBuffer<ExportSplatData> _ExportBuffer;

float3 ColorToSH0(float3 col)
{
    return (col - 0.5) / 0.2820948;
}
float InvSigmoid(float v)
{
    return log(v / max(1 - v, 1.0e-6));
}

// SH rotation
#include "SphericalHarmonics.hlsl"

void RotateSH(inout SplatSHData sh, float3x3 rot)
{
    float3 shin[16];
    float3 shout[16];
    shin[0] = sh.col;
    shin[1] = sh.sh1;
    shin[2] = sh.sh2;
    shin[3] = sh.sh3;
    shin[4] = sh.sh4;
    shin[5] = sh.sh5;
    shin[6] = sh.sh6;
    shin[7] = sh.sh7;
    shin[8] = sh.sh8;
    shin[9] = sh.sh9;
    shin[10] = sh.sh10;
    shin[11] = sh.sh11;
    shin[12] = sh.sh12;
    shin[13] = sh.sh13;
    shin[14] = sh.sh14;
    shin[15] = sh.sh15;
    RotateSH(rot, 4, shin, shout);
    sh.col = shout[0];
    sh.sh1 = shout[1];
    sh.sh2 = shout[2];
    sh.sh3 = shout[3];
    sh.sh4 = shout[4];
    sh.sh5 = shout[5];
    sh.sh6 = shout[6];
    sh.sh7 = shout[7];
    sh.sh8 = shout[8];
    sh.sh9 = shout[9];
    sh.sh10 = shout[10];
    sh.sh11 = shout[11];
    sh.sh12 = shout[12];
    sh.sh13 = shout[13];
    sh.sh14 = shout[14];
    sh.sh15 = shout[15];
}

float3x3 CalcSHRotMatrix(float4x4 objToWorld)
{
    float3x3 m = (float3x3)objToWorld;
    float sx = length(float3(m[0][0], m[0][1], m[0][2]));
    float sy = length(float3(m[1][0], m[1][1], m[1][2]));
    float sz = length(float3(m[2][0], m[2][1], m[2][2]));

    float invSX = 1.0 / sx;
    float invSY = 1.0 / sy;
    float invSZ = 1.0 / sz;

    m[0][0] *= invSX;
    m[0][1] *= invSX;
    m[0][2] *= invSX;
    m[1][0] *= invSY;
    m[1][1] *= invSY;
    m[1][2] *= invSY;
    m[2][0] *= invSZ;
    m[2][1] *= invSZ;
    m[2][2] *= invSZ;
    return m;
}


float4 _ExportTransformRotation;
float3 _ExportTransformScale;
uint _ExportTransformFlags;
// Max allowed per-axis (object-space) scale for export. Splats larger than this (typically
// degenerate "floater" gaussians the live renderer hides) are skipped so they don't show
// up as spikes in external PLY/SPZ viewers. <= 0 disables the size filter.
float _ExportMaxScale;

[numthreads(GROUP_SIZE,1,1)]
void CSExportData (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    SplatData src = LoadSplatData(idx);

    bool isCut = IsSplatCut(src.pos);

    // Skip splats that the live renderer discards (CSCalcViewData) but external viewers do not:
    // non-finite data, and pathologically oversized gaussians that render as spikes/needles.
    bool isBad = !AllFinite3(src.pos) || !AllFinite3(src.scale) || !AllFinite4(src.rot);
    if (!isBad && _ExportMaxScale > 0)
    {
        float3 absScale = abs(src.scale);
        float maxAxis = max(absScale.x, max(absScale.y, absScale.z));
        if (maxAxis > _ExportMaxScale)
            isBad = true;
    }

    // transform splat by matrix, if needed
    if (_ExportTransformFlags != 0)
    {
        src.pos = mul(_MatrixObjectToWorld, float4(src.pos,1)).xyz;

        // note: this only handles axis flips from scale, not any arbitrary scaling
        if (_ExportTransformScale.x < 0)
            src.rot.yz = -src.rot.yz;
        if (_ExportTransformScale.y < 0)
            src.rot.xz = -src.rot.xz;
        if (_ExportTransformScale.z < 0)
            src.rot.xy = -src.rot.xy;
        src.rot = QuatMul(_ExportTransformRotation, src.rot);
        src.scale *= abs(_ExportTransformScale);

        float3x3 shRot = CalcSHRotMatrix(_MatrixObjectToWorld);
        RotateSH(src.sh, shRot);
    }

    ExportSplatData dst;
    dst.pos = src.pos;
    dst.nor = 0;
    dst.dc0 = ColorToSH0(src.sh.col);
    
    dst.shR14 = float4(src.sh.sh1.r, src.sh.sh2.r, src.sh.sh3.r, src.sh.sh4.r);
    dst.shR58 = float4(src.sh.sh5.r, src.sh.sh6.r, src.sh.sh7.r, src.sh.sh8.r);
    dst.shR9C = float4(src.sh.sh9.r, src.sh.sh10.r, src.sh.sh11.r, src.sh.sh12.r);
    dst.shRDF = float3(src.sh.sh13.r, src.sh.sh14.r, src.sh.sh15.r);
    
    dst.shG14 = float4(src.sh.sh1.g, src.sh.sh2.g, src.sh.sh3.g, src.sh.sh4.g);
    dst.shG58 = float4(src.sh.sh5.g, src.sh.sh6.g, src.sh.sh7.g, src.sh.sh8.g);
    dst.shG9C = float4(src.sh.sh9.g, src.sh.sh10.g, src.sh.sh11.g, src.sh.sh12.g);
    dst.shGDF = float3(src.sh.sh13.g, src.sh.sh14.g, src.sh.sh15.g);
    
    dst.shB14 = float4(src.sh.sh1.b, src.sh.sh2.b, src.sh.sh3.b, src.sh.sh4.b);
    dst.shB58 = float4(src.sh.sh5.b, src.sh.sh6.b, src.sh.sh7.b, src.sh.sh8.b);
    dst.shB9C = float4(src.sh.sh9.b, src.sh.sh10.b, src.sh.sh11.b, src.sh.sh12.b);
    dst.shBDF = float3(src.sh.sh13.b, src.sh.sh14.b, src.sh.sh15.b);
    
    dst.opacity = InvSigmoid(src.opacity);
    dst.scale = log(src.scale);
    dst.rot = src.rot.wxyz;

    if (isCut || isBad)
        dst.nor = 1; // mark as skipped for export
    
    _ExportBuffer[idx] = dst;
}

// Smart decimation: score splat visual importance (higher = keep).
// Removes low-opacity, tiny, and needle-like splats first — ideal for Android VR budgets.
RWStructuredBuffer<float> _DecimationScores;
float _DecimationOpacityWeight;
float _DecimationSizeWeight;
float _DecimationAnisotropyPenalty;
float _DecimationMaxScale;

float ComputeDecimationImportance(SplatData s)
{
    float opacity = max(s.opacity, 1.0e-4);
    float3 scale = max(abs(s.scale), 1.0e-6);
    float geomSize = pow(scale.x * scale.y * scale.z, 1.0 / 3.0);
    float maxAxis = max(scale.x, max(scale.y, scale.z));
    float minAxis = min(min(scale.x, scale.y), scale.z);
    float anisotropy = maxAxis / (minAxis + 1.0e-6);

    float opacityScore = pow(opacity, _DecimationOpacityWeight);
    float sizeScore = pow(geomSize, _DecimationSizeWeight);
    float anisotropyFactor = 1.0 / (1.0 + anisotropy * _DecimationAnisotropyPenalty);

    float importance = opacityScore * sizeScore * anisotropyFactor;

    if (_DecimationMaxScale > 0.0 && maxAxis > _DecimationMaxScale)
        importance *= 1.0e-3;

    return importance;
}

[numthreads(GROUP_SIZE,1,1)]
void CSComputeDecimationScores(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    if (_SplatBitsValid)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        uint wordVal = _SplatDeletedBits.Load(wordIdx * 4);
        if (wordVal & (1u << bitIdx))
        {
            _DecimationScores[idx] = 1.0e20;
            return;
        }
    }

    if (IsSplatCut(LoadSplatPos(idx)))
    {
        _DecimationScores[idx] = 1.0e20;
        return;
    }

    SplatData s = LoadSplatData(idx);
    _DecimationScores[idx] = ComputeDecimationImportance(s);
}

RWByteAddressBuffer _CopyDstPos;
RWByteAddressBuffer _CopyDstOther;
RWByteAddressBuffer _CopyDstSH;
RWByteAddressBuffer _CopyDstEditDeleted;
RWTexture2D<float4> _CopyDstColor;
uint _CopyDstSize, _CopySrcStartIndex, _CopyDstStartIndex, _CopyCount;

float4x4 _CopyTransformMatrix;
float4 _CopyTransformRotation;
float3 _CopyTransformScale;

// Read-only versions of source buffers to avoid counting as UAVs
ByteAddressBuffer _CopySrcPos;
ByteAddressBuffer _CopySrcOther;
ByteAddressBuffer _CopySrcSH;
ByteAddressBuffer _CopySrcDeletedBits;

// Helper functions for ByteAddressBuffer (read-only)
uint LoadUShortRO(ByteAddressBuffer dataBuffer, uint addrU)
{
    uint addrA = addrU & ~0x3;
    uint val = dataBuffer.Load(addrA);
    if (addrU != addrA)
        val >>= 16;
    return val & 0xFFFF;
}

uint LoadUIntRO(ByteAddressBuffer dataBuffer, uint addrU)
{
    uint addrA = addrU & ~0x3;
    uint val = dataBuffer.Load(addrA);
    if (addrU != addrA)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        val = (val >> 16) | ((val1 & 0xFFFF) << 16);
    }
    return val;
}

float3 LoadAndDecodeVectorRO(ByteAddressBuffer dataBuffer, uint addrU, uint fmt)
{
    uint addrA = addrU & ~0x3;
    uint val0 = dataBuffer.Load(addrA);
    float3 res = 0;
    if (fmt == VECTOR_FMT_32F)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        uint val2 = dataBuffer.Load(addrA + 8);
        if (addrU != addrA)
        {
            uint val3 = dataBuffer.Load(addrA + 12);
            val0 = (val0 >> 16) | ((val1 & 0xFFFF) << 16);
            val1 = (val1 >> 16) | ((val2 & 0xFFFF) << 16);
            val2 = (val2 >> 16) | ((val3 & 0xFFFF) << 16);
        }
        res = float3(asfloat(val0), asfloat(val1), asfloat(val2));
    }
    else if (fmt == VECTOR_FMT_16)
    {
        uint val1 = dataBuffer.Load(addrA + 4);
        if (addrU != addrA)
        {
            val0 = (val0 >> 16) | ((val1 & 0xFFFF) << 16);
            val1 >>= 16;
        }
        res = DecodePacked_16_16_16(uint2(val0, val1));
    }
    else if (fmt == VECTOR_FMT_11)
    {
        if (addrU != addrA)
            val0 >>= 16;
        res = DecodePacked_11_10_11(val0);
    }
    else if (fmt == VECTOR_FMT_6)
    {
        if (addrU != addrA)
            val0 >>= 16;
        res = DecodePacked_6_5_5(val0);
    }
    return res;
}

// Load splat data using read-only buffers (to avoid UAV limit)
SplatData LoadSplatDataCopy(uint idx)
{
    SplatData s = (SplatData)0;

    // figure out raw data offsets / locations
    uint3 coord = SplatIndexToPixelIndex(idx);

    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    uint posFmt = _SplatFormat & 0xFF;

    uint posStride = 0;
    if (posFmt == VECTOR_FMT_32F)
        posStride = 12;
    else if (posFmt == VECTOR_FMT_16)
        posStride = 6;
    else if (posFmt == VECTOR_FMT_11)
        posStride = 4;
    else if (posFmt == VECTOR_FMT_6)
        posStride = 2;

    uint otherStride = 4; // rotation is 10.10.10.2
    if (scaleFmt == VECTOR_FMT_32F)
        otherStride += 12;
    else if (scaleFmt == VECTOR_FMT_16)
        otherStride += 6;
    else if (scaleFmt == VECTOR_FMT_11)
        otherStride += 4;
    else if (scaleFmt == VECTOR_FMT_6)
        otherStride += 2;
    if (shFormat > VECTOR_FMT_6)
        otherStride += 2;
    uint otherAddr = idx * otherStride;

    uint shStride = 0;
    if (shFormat == VECTOR_FMT_32F)
        shStride = 192; // 15*3 fp32, rounded up to multiple of 16
    else if (shFormat == VECTOR_FMT_16 || shFormat > VECTOR_FMT_6)
        shStride = 96; // 15*3 fp16, rounded up to multiple of 16
    else if (shFormat == VECTOR_FMT_11)
        shStride = 60; // 15x uint
    else if (shFormat == VECTOR_FMT_6)
        shStride = 32; // 15x ushort, rounded up to multiple of 4

    // load raw splat data
    s.pos = LoadAndDecodeVectorRO(_CopySrcPos, idx * posStride, posFmt);
    s.rot = DecodeRotation(DecodePacked_10_10_10_2(LoadUIntRO(_CopySrcOther, otherAddr)));
    s.scale = LoadAndDecodeVectorRO(_CopySrcOther, otherAddr + 4, scaleFmt);
    half4 col = LoadSplatColTex(coord);

    uint shIndex = idx;
    if (shFormat > VECTOR_FMT_6)
        shIndex = LoadUShortRO(_CopySrcOther, otherAddr + otherStride - 2);

    uint shOffset = shIndex * shStride;
    uint4 shRaw0 = _CopySrcSH.Load4(shOffset);
    uint4 shRaw1 = _CopySrcSH.Load4(shOffset + 16);
    if (shFormat == VECTOR_FMT_32F)
    {
        uint4 shRaw2 = _CopySrcSH.Load4(shOffset + 32);
        uint4 shRaw3 = _CopySrcSH.Load4(shOffset + 48);
        uint4 shRaw4 = _CopySrcSH.Load4(shOffset + 64);
        uint4 shRaw5 = _CopySrcSH.Load4(shOffset + 80);
        uint4 shRaw6 = _CopySrcSH.Load4(shOffset + 96);
        uint4 shRaw7 = _CopySrcSH.Load4(shOffset + 112);
        uint4 shRaw8 = _CopySrcSH.Load4(shOffset + 128);
        uint4 shRaw9 = _CopySrcSH.Load4(shOffset + 144);
        uint4 shRawA = _CopySrcSH.Load4(shOffset + 160);
        uint  shRawB = _CopySrcSH.Load(shOffset + 176);
        s.sh.sh1.r  = asfloat(shRaw0.x); s.sh.sh1.g =  asfloat(shRaw0.y); s.sh.sh1.b =  asfloat(shRaw0.z);
        s.sh.sh2.r  = asfloat(shRaw0.w); s.sh.sh2.g =  asfloat(shRaw1.x); s.sh.sh2.b =  asfloat(shRaw1.y);
        s.sh.sh3.r  = asfloat(shRaw1.z); s.sh.sh3.g =  asfloat(shRaw1.w); s.sh.sh3.b =  asfloat(shRaw2.x);
        s.sh.sh4.r  = asfloat(shRaw2.y); s.sh.sh4.g =  asfloat(shRaw2.z); s.sh.sh4.b =  asfloat(shRaw2.w);
        s.sh.sh5.r  = asfloat(shRaw3.x); s.sh.sh5.g =  asfloat(shRaw3.y); s.sh.sh5.b =  asfloat(shRaw3.z);
        s.sh.sh6.r  = asfloat(shRaw3.w); s.sh.sh6.g =  asfloat(shRaw4.x); s.sh.sh6.b =  asfloat(shRaw4.y);
        s.sh.sh7.r  = asfloat(shRaw4.z); s.sh.sh7.g =  asfloat(shRaw4.w); s.sh.sh7.b =  asfloat(shRaw5.x);
        s.sh.sh8.r  = asfloat(shRaw5.y); s.sh.sh8.g =  asfloat(shRaw5.z); s.sh.sh8.b =  asfloat(shRaw5.w);
        s.sh.sh9.r  = asfloat(shRaw6.x); s.sh.sh9.g =  asfloat(shRaw6.y); s.sh.sh9.b =  asfloat(shRaw6.z);
        s.sh.sh10.r = asfloat(shRaw6.w); s.sh.sh10.g = asfloat(shRaw7.x); s.sh.sh10.b = asfloat(shRaw7.y);
        s.sh.sh11.r = asfloat(shRaw7.z); s.sh.sh11.g = asfloat(shRaw7.w); s.sh.sh11.b = asfloat(shRaw8.x);
        s.sh.sh12.r = asfloat(shRaw8.y); s.sh.sh12.g = asfloat(shRaw8.z); s.sh.sh12.b = asfloat(shRaw8.w);
        s.sh.sh13.r = asfloat(shRaw9.x); s.sh.sh13.g = asfloat(shRaw9.y); s.sh.sh13.b = asfloat(shRaw9.z);
        s.sh.sh14.r = asfloat(shRaw9.w); s.sh.sh14.g = asfloat(shRawA.x); s.sh.sh14.b = asfloat(shRawA.y);
        s.sh.sh15.r = asfloat(shRawA.z); s.sh.sh15.g = asfloat(shRawA.w); s.sh.sh15.b = asfloat(shRawB);
    }
    else if (shFormat == VECTOR_FMT_16 || shFormat > VECTOR_FMT_6)
    {
        uint4 shRaw2 = _CopySrcSH.Load4(shOffset + 32);
        uint4 shRaw3 = _CopySrcSH.Load4(shOffset + 48);
        uint4 shRaw4 = _CopySrcSH.Load4(shOffset + 64);
        uint3 shRaw5 = _CopySrcSH.Load3(shOffset + 80);
        s.sh.sh1.r  = f16tof32(shRaw0.x      ); s.sh.sh1.g =  f16tof32(shRaw0.x >> 16); s.sh.sh1.b =  f16tof32(shRaw0.y      );
        s.sh.sh2.r  = f16tof32(shRaw0.y >> 16); s.sh.sh2.g =  f16tof32(shRaw0.z      ); s.sh.sh2.b =  f16tof32(shRaw0.z >> 16);
        s.sh.sh3.r  = f16tof32(shRaw0.w      ); s.sh.sh3.g =  f16tof32(shRaw0.w >> 16); s.sh.sh3.b =  f16tof32(shRaw1.x      );
        s.sh.sh4.r  = f16tof32(shRaw1.x >> 16); s.sh.sh4.g =  f16tof32(shRaw1.y      ); s.sh.sh4.b =  f16tof32(shRaw1.y >> 16);
        s.sh.sh5.r  = f16tof32(shRaw1.z      ); s.sh.sh5.g =  f16tof32(shRaw1.z >> 16); s.sh.sh5.b =  f16tof32(shRaw1.w      );
        s.sh.sh6.r  = f16tof32(shRaw1.w >> 16); s.sh.sh6.g =  f16tof32(shRaw2.x      ); s.sh.sh6.b =  f16tof32(shRaw2.x >> 16);
        s.sh.sh7.r  = f16tof32(shRaw2.y      ); s.sh.sh7.g =  f16tof32(shRaw2.y >> 16); s.sh.sh7.b =  f16tof32(shRaw2.z      );
        s.sh.sh8.r  = f16tof32(shRaw2.z >> 16); s.sh.sh8.g =  f16tof32(shRaw2.w      ); s.sh.sh8.b =  f16tof32(shRaw2.w >> 16);
        s.sh.sh9.r  = f16tof32(shRaw3.x      ); s.sh.sh9.g =  f16tof32(shRaw3.x >> 16); s.sh.sh9.b =  f16tof32(shRaw3.y      );
        s.sh.sh10.r = f16tof32(shRaw3.y >> 16); s.sh.sh10.g = f16tof32(shRaw3.z      ); s.sh.sh10.b = f16tof32(shRaw3.z >> 16);
        s.sh.sh11.r = f16tof32(shRaw3.w      ); s.sh.sh11.g = f16tof32(shRaw3.w >> 16); s.sh.sh11.b = f16tof32(shRaw4.x      );
        s.sh.sh12.r = f16tof32(shRaw4.x >> 16); s.sh.sh12.g = f16tof32(shRaw4.y      ); s.sh.sh12.b = f16tof32(shRaw4.y >> 16);
        s.sh.sh13.r = f16tof32(shRaw4.z      ); s.sh.sh13.g = f16tof32(shRaw4.z >> 16); s.sh.sh13.b = f16tof32(shRaw4.w      );
        s.sh.sh14.r = f16tof32(shRaw4.w >> 16); s.sh.sh14.g = f16tof32(shRaw5.x      ); s.sh.sh14.b = f16tof32(shRaw5.x >> 16);
        s.sh.sh15.r = f16tof32(shRaw5.y      ); s.sh.sh15.g = f16tof32(shRaw5.y >> 16); s.sh.sh15.b = f16tof32(shRaw5.z      );
    }
    else if (shFormat == VECTOR_FMT_11)
    {
        uint4 shRaw2 = _CopySrcSH.Load4(shOffset + 32);
        uint3 shRaw3 = _CopySrcSH.Load3(shOffset + 48);
        s.sh.sh1 =  DecodePacked_11_10_11(shRaw0.x);
        s.sh.sh2 =  DecodePacked_11_10_11(shRaw0.y);
        s.sh.sh3 =  DecodePacked_11_10_11(shRaw0.z);
        s.sh.sh4 =  DecodePacked_11_10_11(shRaw0.w);
        s.sh.sh5 =  DecodePacked_11_10_11(shRaw1.x);
        s.sh.sh6 =  DecodePacked_11_10_11(shRaw1.y);
        s.sh.sh7 =  DecodePacked_11_10_11(shRaw1.z);
        s.sh.sh8 =  DecodePacked_11_10_11(shRaw1.w);
        s.sh.sh9 =  DecodePacked_11_10_11(shRaw2.x);
        s.sh.sh10 = DecodePacked_11_10_11(shRaw2.y);
        s.sh.sh11 = DecodePacked_11_10_11(shRaw2.z);
        s.sh.sh12 = DecodePacked_11_10_11(shRaw2.w);
        s.sh.sh13 = DecodePacked_11_10_11(shRaw3.x);
        s.sh.sh14 = DecodePacked_11_10_11(shRaw3.y);
        s.sh.sh15 = DecodePacked_11_10_11(shRaw3.z);
    }
    else if (shFormat == VECTOR_FMT_6)
    {
        s.sh.sh1 =  DecodePacked_5_6_5(shRaw0.x);
        s.sh.sh2 =  DecodePacked_5_6_5(shRaw0.x >> 16);
        s.sh.sh3 =  DecodePacked_5_6_5(shRaw0.y);
        s.sh.sh4 =  DecodePacked_5_6_5(shRaw0.y >> 16);
        s.sh.sh5 =  DecodePacked_5_6_5(shRaw0.z);
        s.sh.sh6 =  DecodePacked_5_6_5(shRaw0.z >> 16);
        s.sh.sh7 =  DecodePacked_5_6_5(shRaw0.w);
        s.sh.sh8 =  DecodePacked_5_6_5(shRaw0.w >> 16);
        s.sh.sh9 =  DecodePacked_5_6_5(shRaw1.x);
        s.sh.sh10 = DecodePacked_5_6_5(shRaw1.x >> 16);
        s.sh.sh11 = DecodePacked_5_6_5(shRaw1.y);
        s.sh.sh12 = DecodePacked_5_6_5(shRaw1.y >> 16);
        s.sh.sh13 = DecodePacked_5_6_5(shRaw1.z);
        s.sh.sh14 = DecodePacked_5_6_5(shRaw1.z >> 16);
        s.sh.sh15 = DecodePacked_5_6_5(shRaw1.w);
    }

    // Handle chunk-relative data
    uint chunkIdx = idx / kChunkSize;
    if (chunkIdx < _SplatChunkCount)
    {
        SplatChunkInfo chunk = _SplatChunks[chunkIdx];
        float3 posMin = float3(chunk.posX.x, chunk.posY.x, chunk.posZ.x);
        float3 posMax = float3(chunk.posX.y, chunk.posY.y, chunk.posZ.y);
        half3 sclMin = half3(f16tof32(chunk.sclX    ), f16tof32(chunk.sclY    ), f16tof32(chunk.sclZ    ));
        half3 sclMax = half3(f16tof32(chunk.sclX>>16), f16tof32(chunk.sclY>>16), f16tof32(chunk.sclZ>>16));
        half4 colMin = half4(f16tof32(chunk.colR    ), f16tof32(chunk.colG    ), f16tof32(chunk.colB    ), f16tof32(chunk.colA    ));
        half4 colMax = half4(f16tof32(chunk.colR>>16), f16tof32(chunk.colG>>16), f16tof32(chunk.colB>>16), f16tof32(chunk.colA>>16));
        half3 shMin = half3(f16tof32(chunk.shR    ), f16tof32(chunk.shG    ), f16tof32(chunk.shB    ));
        half3 shMax = half3(f16tof32(chunk.shR>>16), f16tof32(chunk.shG>>16), f16tof32(chunk.shB>>16));
        s.pos = lerp(posMin, posMax, s.pos);
        s.scale     = lerp(sclMin, sclMax, s.scale);
        s.scale *= s.scale;
        s.scale *= s.scale;
        s.scale *= s.scale;
        col   = lerp(colMin, colMax, col);
        col.a = InvSquareCentered01(col.a);

        if (shFormat > VECTOR_FMT_32F && shFormat <= VECTOR_FMT_6)
        {
            s.sh.sh1    = lerp(shMin, shMax, s.sh.sh1 );
            s.sh.sh2    = lerp(shMin, shMax, s.sh.sh2 );
            s.sh.sh3    = lerp(shMin, shMax, s.sh.sh3 );
            s.sh.sh4    = lerp(shMin, shMax, s.sh.sh4 );
            s.sh.sh5    = lerp(shMin, shMax, s.sh.sh5 );
            s.sh.sh6    = lerp(shMin, shMax, s.sh.sh6 );
            s.sh.sh7    = lerp(shMin, shMax, s.sh.sh7 );
            s.sh.sh8    = lerp(shMin, shMax, s.sh.sh8 );
            s.sh.sh9    = lerp(shMin, shMax, s.sh.sh9 );
            s.sh.sh10   = lerp(shMin, shMax, s.sh.sh10);
            s.sh.sh11   = lerp(shMin, shMax, s.sh.sh11);
            s.sh.sh12   = lerp(shMin, shMax, s.sh.sh12);
            s.sh.sh13   = lerp(shMin, shMax, s.sh.sh13);
            s.sh.sh14   = lerp(shMin, shMax, s.sh.sh14);
            s.sh.sh15   = lerp(shMin, shMax, s.sh.sh15);
        }
    }
    s.opacity   = col.a;
    s.sh.col    = col.rgb;

    return s;
}

[numthreads(GROUP_SIZE,1,1)]
void CSCopySplats (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _CopyCount)
        return;
    uint srcIdx = _CopySrcStartIndex + idx;
    uint dstIdx = _CopyDstStartIndex + idx;
    if (srcIdx >= _SplatCount || dstIdx >= _CopyDstSize)
        return;

    SplatData src = LoadSplatDataCopy(srcIdx);

    // transform the splat
    src.pos = mul(_CopyTransformMatrix, float4(src.pos,1)).xyz;
    // note: this only handles axis flips from scale, not any arbitrary scaling
    if (_CopyTransformScale.x < 0)
        src.rot.yz = -src.rot.yz;
    if (_CopyTransformScale.y < 0)
        src.rot.xz = -src.rot.xz;
    if (_CopyTransformScale.z < 0)
        src.rot.xy = -src.rot.xy;
    src.rot = QuatMul(_CopyTransformRotation, src.rot);
    src.scale *= abs(_CopyTransformScale);

    float3x3 shRot = CalcSHRotMatrix(_CopyTransformMatrix);
    RotateSH(src.sh, shRot);

    // output data into destination:
    // pos
    uint posStride = 12;
    _CopyDstPos.Store3(dstIdx * posStride, PackFloat3AsUintBits(src.pos));
    // rot + scale
    uint otherStride = 4 + 12;
    uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(src.rot));
    _CopyDstOther.Store4(dstIdx * otherStride, uint4(
        rotVal,
        asuint(src.scale.x),
        asuint(src.scale.y),
        asuint(src.scale.z)));
    // color
    uint3 pixelIndex = SplatIndexToPixelIndex(dstIdx);
    _CopyDstColor[pixelIndex.xy] = float4(src.sh.col, src.opacity);

    // SH
    uint shStride = 192; // 15*3 fp32, rounded up to multiple of 16
    uint shOffset = dstIdx * shStride;
    _CopyDstSH.Store3(shOffset + 12 * 0, PackHalf3AsUintBits(src.sh.sh1));
    _CopyDstSH.Store3(shOffset + 12 * 1, PackHalf3AsUintBits(src.sh.sh2));
    _CopyDstSH.Store3(shOffset + 12 * 2, PackHalf3AsUintBits(src.sh.sh3));
    _CopyDstSH.Store3(shOffset + 12 * 3, PackHalf3AsUintBits(src.sh.sh4));
    _CopyDstSH.Store3(shOffset + 12 * 4, PackHalf3AsUintBits(src.sh.sh5));
    _CopyDstSH.Store3(shOffset + 12 * 5, PackHalf3AsUintBits(src.sh.sh6));
    _CopyDstSH.Store3(shOffset + 12 * 6, PackHalf3AsUintBits(src.sh.sh7));
    _CopyDstSH.Store3(shOffset + 12 * 7, PackHalf3AsUintBits(src.sh.sh8));
    _CopyDstSH.Store3(shOffset + 12 * 8, PackHalf3AsUintBits(src.sh.sh9));
    _CopyDstSH.Store3(shOffset + 12 * 9, PackHalf3AsUintBits(src.sh.sh10));
    _CopyDstSH.Store3(shOffset + 12 * 10, PackHalf3AsUintBits(src.sh.sh11));
    _CopyDstSH.Store3(shOffset + 12 * 11, PackHalf3AsUintBits(src.sh.sh12));
    _CopyDstSH.Store3(shOffset + 12 * 12, PackHalf3AsUintBits(src.sh.sh13));
    _CopyDstSH.Store3(shOffset + 12 * 13, PackHalf3AsUintBits(src.sh.sh14));
    _CopyDstSH.Store3(shOffset + 12 * 14, PackHalf3AsUintBits(src.sh.sh15));

    // deleted bits
    uint srcWordIdx = srcIdx / 32;
    uint srcBitIdx = srcIdx & 31;
    if (_CopySrcDeletedBits.Load(srcWordIdx * 4) & (1u << srcBitIdx))
    {
        uint dstWordIdx = dstIdx / 32;
        uint dstBitIdx = dstIdx & 31;
        _CopyDstEditDeleted.InterlockedOr(dstWordIdx * 4, 1u << dstBitIdx);
    }
}

// Physics system variables
struct SphereCollider
{
    float3 position;
    float3 velocity;
    float radius;
    float mass;
    float restitution;
};

RWStructuredBuffer<SphereCollider> _SphereColliders;
uint _SphereColliderCount;

RWStructuredBuffer<float3> _SplatVelocities;
RWStructuredBuffer<float3> _SplatPrevPositions;
RWStructuredBuffer<float3> _SplatOriginalPositions;
RWStructuredBuffer<float3> _SplatPersistentVelocities; // Persistent velocities for continuous animation
float _DeltaTime;
float _Gravity;
float _Damping;
float _SplatMass;
float _MinVelocity;
float _CustomTime;

// Dedicated wind physics variables
float _WindGravity;
float _WindDamping;
float _WindMinVelocity;

[numthreads(GROUP_SIZE,1,1)]
void CSInitPhysics(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
        
    // Initialize velocities to zero (should already be zero from CPU)
    _SplatVelocities[idx] = float3(0, 0, 0);
    
    // Store current positions as previous positions
    // This should NOT modify the actual splat positions, just store them for reference
    _SplatPrevPositions[idx] = LoadSplatPos(idx);
    
    // DO NOT modify the actual splat positions during initialization
}

[numthreads(GROUP_SIZE,1,1)]
void CSApplyCollisions(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
        
    float3 splatPos = LoadSplatPos(idx);
    float3 splatVel = _SplatVelocities[idx];
    bool collisionOccurred = false;
    
        // Only check collisions if there are active colliders
        if (_SphereColliderCount > 0)
        {
            // Check collision with all sphere colliders
            for (uint i = 0; i < _SphereColliderCount; i++)
            {
                SphereCollider sphere = _SphereColliders[i];
                
                // Transform sphere position from world space to local space
                float3 sphereLocalPos = mul(_MatrixWorldToObject, float4(sphere.position, 1)).xyz;
                
                float3 toSplat = splatPos - sphereLocalPos;
                float distance = length(toSplat);
                
                // Check if collision occurs
                if (distance < sphere.radius && distance > 0.001)
                {
                    collisionOccurred = true;
                    
                    // Calculate collision normal
                    float3 normal = toSplat / distance;
                    
                    // Calculate relative velocity
                    float3 relativeVel = splatVel - sphere.velocity;
                    float velAlongNormal = dot(relativeVel, normal);
                    
                    // Don't resolve if velocities are separating
                    if (velAlongNormal > 0)
                        continue;
                        
                    // Calculate restitution (reduced impact)
                    float e = sphere.restitution * 0.3; // Reduce impact strength
                    
                    // Calculate impulse scalar with reduced force
                    float j = -(1 + e) * velAlongNormal;
                    j /= (1 / _SplatMass) + (1 / sphere.mass);
                    j *= 0.2; // Further reduce impulse strength
                    
                    // Apply impulse
                    float3 impulse = j * normal;
                    splatVel += impulse / _SplatMass;
                    
                    // Add smaller randomness for more realistic behavior
                    float3 randomForce = float3(
                        (frac(sin(dot(float2(idx, _CustomTime), float2(12.9898, 78.233))) * 43758.5453) - 0.5) * 2.0,
                        (frac(sin(dot(float2(idx + 1000, _CustomTime), float2(12.9898, 78.233))) * 43758.5453) - 0.5) * 2.0,
                        (frac(sin(dot(float2(idx + 2000, _CustomTime), float2(12.9898, 78.233))) * 43758.5453) - 0.5) * 2.0
                    ) * 0.1; // Much smaller random force
                    
                    splatVel += randomForce;
                    
                    // Push splat out of collision more gently
                    float penetration = sphere.radius - distance;
                    splatPos += normal * penetration * 0.3; // Gentler push
                }
            }
        }
    
    // Store updated velocity
    _SplatVelocities[idx] = splatVel;
    
    // Update position in buffer if collision occurred
    if (collisionOccurred)
    {
        uint fmt = _SplatFormat & 0xFF;
        if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
        {
            uint stride = 12;
            _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(splatPos));
        }
    }
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdatePhysics(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 currentPos = LoadSplatPos(idx);
    float3 velocity = _SplatVelocities[idx];
    
    // Check per-splat no-gravity flag (bit 0)
    uint flagWordIdx = idx / 32;
    uint flagBitIdx = idx & 31;
    uint flagWord = _SplatAnimFlags.Load(flagWordIdx * 4);
    bool noGravity = (flagWord & (1u << flagBitIdx)) != 0;
    
    // Only apply physics if the splat has some velocity
    float velocityMagnitude = length(velocity);
    if (velocityMagnitude > 0.001)
    {
        // Apply gravity only if not flagged for no-gravity
        float3 moveVelocity = velocity;
        if (!noGravity)
        {
            moveVelocity.y -= _Gravity * _DeltaTime * 0.5;
        }
        
        // Update position FIRST using full velocity (before damping)
        float3 newPos = currentPos + moveVelocity * _DeltaTime;
        
        // Update position in buffer
        uint fmt = _SplatFormat & 0xFF;
        if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
        {
            uint stride = 12;
            _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(newPos));
        }
        
        // Apply damping AFTER position update (for physics settling, not continuous animation)
        velocity = moveVelocity * (1.0 - _Damping * _DeltaTime * 2.0);
        
        // Minimum velocity threshold to prevent jittering
        if (length(velocity) < _MinVelocity)
        {
            velocity = float3(0, 0, 0);
        }
    }
    
    // Always store updated values
    _SplatVelocities[idx] = velocity;
    _SplatPrevPositions[idx] = currentPos;
}

[numthreads(GROUP_SIZE,1,1)]
void CSDistanceCull(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    if (_EnableDistanceCulling == 0)
        return;
        
    // Get splat position in world space
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Calculate distance from cull origin
    float distanceFromOrigin = length(worldPos - _CullOrigin);
    
    // If beyond kill radius, mark as deleted
    if (distanceFromOrigin > _KillRadius)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    }
}

// Simple 3D noise function for wind effects
float noise3D(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    
    float n = i.x + i.y * 57.0 + i.z * 113.0;
    
    float res = lerp(lerp(lerp(frac(sin(n) * 43758.5453),
                              frac(sin(n + 1.0) * 43758.5453), f.x),
                          lerp(frac(sin(n + 57.0) * 43758.5453),
                              frac(sin(n + 58.0) * 43758.5453), f.x), f.y),
                     lerp(lerp(frac(sin(n + 113.0) * 43758.5453),
                              frac(sin(n + 114.0) * 43758.5453), f.x),
                          lerp(frac(sin(n + 170.0) * 43758.5453),
                              frac(sin(n + 171.0) * 43758.5453), f.x), f.y), f.z);
    return res;
}

float3 curlNoise(float3 p)
{
    const float e = 0.1;
    
    float3 dx = float3(e, 0.0, 0.0);
    float3 dy = float3(0.0, e, 0.0);
    float3 dz = float3(0.0, 0.0, e);
    
    float3 p_x0 = noise3D(p - dx).xxx;
    float3 p_x1 = noise3D(p + dx).xxx;
    float3 p_y0 = noise3D(p - dy).xxx;
    float3 p_y1 = noise3D(p + dy).xxx;
    float3 p_z0 = noise3D(p - dz).xxx;
    float3 p_z1 = noise3D(p + dz).xxx;
    
    float x = p_y1.z - p_y0.z - p_z1.y + p_z0.y;
    float y = p_z1.x - p_z0.x - p_x1.z + p_x0.z;
    float z = p_x1.y - p_x0.y - p_y1.x + p_y0.x;
    
    return normalize(float3(x, y, z) / (2.0 * e));
}

bool IsInWindBox(float3 worldPos, WindBoxData windBox)
{
    float3 boxPos = mul(windBox.worldToBox, float4(worldPos, 1.0)).xyz;
    return all(abs(boxPos) <= 1.0);
}

// New function: Get smooth falloff based on distance from box center (ignores box boundaries)
float GetWindInfluence(float3 worldPos, WindBoxData windBox)
{
    float3 toCenter = worldPos - windBox.boxCenter;
    float distance = length(toCenter);
    
    // Create smooth falloff that extends well beyond the box
    float maxInfluenceDistance = 10.0; // Wind affects splats up to 10 units from center
    float influence = 1.0 - smoothstep(0.0, maxInfluenceDistance, distance);
    
    return influence;
}

float3 RotateByQuaternion(float3 v, float4 q)
{
    // Assumes normalized quaternion
    float3 t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

// Calculate force from an attractor - simplified and slower
float3 CalculateAttractorForce(float3 worldPos, AttractorData attractor)
{
    if (attractor.enabled < 0.5)
        return float3(0, 0, 0);
    
    float3 scaleSafe = max(attractor.scale, float3(0.0001, 0.0001, 0.0001));
    float4 invRot = float4(-attractor.rotation.xyz, attractor.rotation.w);
    
    float3 localPos = RotateByQuaternion(worldPos - attractor.position, invRot);
    float3 scaledLocalPos = localPos / scaleSafe;
    
    float3 toAttractor = -scaledLocalPos;
    float distance = length(toAttractor);
    
    if (distance > attractor.range || distance < 0.001)
        return float3(0, 0, 0);
    
    // Calculate falloff (0 at edge, 1 at center)
    float normalizedDist = distance / attractor.range;
    float attenuation = pow(max(0.0, 1.0 - normalizedDist), attractor.falloff);
    
    float3 direction = toAttractor / distance;
    float3 force = float3(0, 0, 0);
    
    if (attractor.mode == 0) // Vortex - swirl around Y axis with height
    {
        // Tangent direction (perpendicular to radial, on XZ plane)
        float3 tangent = float3(-direction.z, 0, direction.x);
        // Spiral: mostly tangent with slight inward pull
        force = tangent * 0.8 + direction * 0.2;
        // Apply vortex height (0 = flat, positive = upward spiral, negative = downward)
        force.y = attractor.vortexHeight * (1.0 - normalizedDist);
    }
    else if (attractor.mode == 1) // Attract - pull toward center
    {
        force = direction;
    }
    else if (attractor.mode == 2) // Repel - push away from center
    {
        force = -direction;
    }
    else if (attractor.mode == 3) // Wave - sine wave distortion with curl
    {
        // Get position relative to attractor
        float3 relPos = scaledLocalPos;
        
        // Calculate wave based on axis
        float perpDist = 0;
        float perpDist2 = 0;
        float3 waveDir = float3(0, 0, 0);
        float3 curlDir = float3(0, 0, 0);
        
        if (attractor.waveAxis == 0) // X axis wave - waves travel along Z, displace in X
        {
            perpDist = relPos.z;
            perpDist2 = relPos.y;
            waveDir = float3(1, 0, 0);
            curlDir = float3(0, 1, 0); // Curl around Y
        }
        else if (attractor.waveAxis == 1) // Y axis wave - radial waves, displace in Y
        {
            perpDist = length(float2(relPos.x, relPos.z));
            perpDist2 = atan2(relPos.z, relPos.x);
            waveDir = float3(0, 1, 0);
            // Curl tangent to radius
            float rad = max(perpDist, 0.001);
            curlDir = float3(-relPos.z / rad, 0, relPos.x / rad);
        }
        else // Z axis wave - waves travel along X, displace in Z
        {
            perpDist = relPos.x;
            perpDist2 = relPos.y;
            waveDir = float3(0, 0, 1);
            curlDir = float3(0, 1, 0); // Curl around Y
        }
        
        // Primary wave with time animation
        float wavePhase = perpDist * attractor.waveFrequency + _WindTime * attractor.waveSpeed;
        float waveAmount = sin(wavePhase) * attractor.waveAmplitude;
        
        // Secondary wave for complex patterns (if enabled)
        if (attractor.secondaryFrequency > 0.01)
        {
            float secondaryPhase = perpDist2 * attractor.secondaryFrequency + _WindTime * attractor.waveSpeed * 0.7;
            waveAmount += sin(secondaryPhase) * attractor.waveAmplitude * 0.5;
        }
        
        // Apply primary wave force
        force = waveDir * waveAmount;
        
        // Add curl/twist effect (rotational motion perpendicular to wave)
        if (attractor.curlStrength > 0.01)
        {
            float curlPhase = perpDist * attractor.waveFrequency * 0.5 + _WindTime * attractor.waveSpeed * 1.3;
            float curlAmount = cos(curlPhase) * attractor.curlStrength;
            force += curlDir * curlAmount * attractor.waveAmplitude;
        }
    }
    
    // Apply strength and attenuation - scale by gizmo size/range/falloff
    float scaleInfluence = max((attractor.scale.x + attractor.scale.y + attractor.scale.z) / 3.0, 0.0001);
    float strengthScale = sqrt(max(attractor.range, 0.0001)) * pow(scaleInfluence, 0.25) * max(attractor.falloff, 0.1);
    float3 localForce = force * attractor.strength * attenuation * strengthScale;
    return RotateByQuaternion(localForce, attractor.rotation);
}

[numthreads(GROUP_SIZE,1,1)]
void CSApplyWindForces(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Skip if physics is not enabled or no wind boxes or attractors
    if (_WindBoxCount == 0 && _AttractorCount == 0)
        return;

    // Debug logging (can be enabled by uncommenting)
    // if (idx == 0) {
    //     float3 debugPos = LoadSplatPos(0);
    //     float3 debugWorldPos = mul(_MatrixObjectToWorld, float4(debugPos, 1)).xyz;
    // }
        
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    float3 totalWindForce = float3(0, 0, 0);
    bool inAnyBox = false;
    bool needsRestoration = false;
    
    // Total accumulated attractor force
    float3 totalAttractorForce = float3(0, 0, 0);
    
    // Check all wind boxes
    bool turbulenceOnlyMode = false;
    float maxTurbulenceSpread = 0.0; // Track maximum spread value from all boxes
    for (uint i = 0; i < _WindBoxCount; i++)
    {
        WindBoxData windBox = _WindBoxes[i];
        
        // Skip disabled boxes
        if ((windBox.flags & 1) == 0)
            continue;
        
        // Check if turbulence-only mode is enabled (bit 3)
        bool isTurbulenceOnly = (windBox.flags & 8) != 0;
        if (isTurbulenceOnly)
        {
            turbulenceOnlyMode = true;
            maxTurbulenceSpread = max(maxTurbulenceSpread, windBox.turbulenceSpread);
        }
        
        // Check wind strength threshold - effects only activate above threshold
        // But still calculate turbulence for visual effects even if below threshold
        bool aboveThreshold = windBox.windStrength >= windBox.windStrengthThreshold;
        if (!aboveThreshold && !isTurbulenceOnly)
            continue;
            
        // Get smooth influence based on distance from center (ignores hard box boundaries)
        float windInfluence = GetWindInfluence(worldPos, windBox);
        bool shouldRestore = (windBox.flags & 4) != 0; // Check restore position flag
        
        // Apply wind if there's any influence (smooth falloff, no hard boundaries)
        if (windInfluence > 0.01)
        {
            inAnyBox = true;
            
            // Create organic flow patterns that ignore box boundaries
            float3 organicFlowDirection = float3(
                sin(_WindTime * 0.7 + idx * 0.1),
                cos(_WindTime * 0.5 + idx * 0.15),
                sin(_WindTime * 0.9 + idx * 0.08)
            );
            organicFlowDirection = normalize(organicFlowDirection);
            
            // Mix organic flow with wind direction for more natural movement
            float3 baseDirection = normalize(lerp(windBox.windDirection, organicFlowDirection, 0.6)); // 60% organic flow
            float3 windForce = baseDirection * windBox.windStrength;
            
            // Add per-splat randomization to break up uniform movement
            float splatRandom1 = frac(sin(dot(float2(idx, idx * 1.5), float2(12.9898, 78.233))) * 43758.5453);
            float splatRandom2 = frac(sin(dot(float2(idx * 2.1, idx * 0.7), float2(12.9898, 78.233))) * 43758.5453);
            float splatRandom3 = frac(sin(dot(float2(idx * 1.3, idx * 2.7), float2(12.9898, 78.233))) * 43758.5453);
            
            // Apply random variation to wind direction and strength for each splat
            float3 randomDirection = normalize(float3(
                splatRandom1 * 2.0 - 1.0,
                splatRandom2 * 2.0 - 1.0,
                splatRandom3 * 2.0 - 1.0
            ));
            
            // Mix random direction with wind direction based on individual variation setting
            float variationAmount = windBox.individualVariation;
            windForce = normalize(lerp(windBox.windDirection, randomDirection, variationAmount)) * windBox.windStrength;
            
            // Add per-splat strength variation (±50% for more chaos)
            float strengthVariation = 0.5 + (splatRandom1 * 1.0);
            windForce *= strengthVariation;
            
            // Add MORE random chaos forces independent of noise settings
            float3 chaosForce = float3(
                (splatRandom1 - 0.5) * 2.0,
                (splatRandom2 - 0.5) * 2.0,
                (splatRandom3 - 0.5) * 2.0
            ) * windBox.windStrength * 0.3; // 30% of wind strength as pure chaos
            
            windForce += chaosForce;
            
            // Add organic swirling patterns that create natural vortices
            float3 swirlCenter = windBox.boxCenter + float3(
                sin(_WindTime * 0.3) * 2.0,
                cos(_WindTime * 0.4) * 1.5,
                sin(_WindTime * 0.2) * 2.5
            );
            float3 toSwirl = worldPos - swirlCenter;
            float swirlDistance = length(toSwirl);
            
            if (swirlDistance > 0.1)
            {
                // Create organic vortex motion
                float3 swirlTangent = normalize(cross(toSwirl, float3(0, 1, 0)));
                float3 swirlForce = swirlTangent * windBox.windStrength * 0.4 * (1.0 / (1.0 + swirlDistance * 0.1));
                windForce += swirlForce;
            }
            
            // Add noise for variation with per-splat offset
            if (windBox.noiseStrength > 0.0)
            {
                // Use splat index to offset noise sampling for individual behavior
                float3 splatOffset = float3(splatRandom1 * 100.0, splatRandom2 * 100.0, splatRandom3 * 100.0);
                float3 noisePos = (worldPos + splatOffset) * windBox.noiseScale + float3(_WindTime * windBox.noiseSpeed, 0, 0);
                float3 noiseForce = curlNoise(noisePos) * windBox.noiseStrength;
                
                // Add MORE individualized turbulence layers with organic motion
                float3 turbulencePos1 = (worldPos + splatOffset * 0.5) * windBox.noiseScale * 2.0 + float3(sin(_WindTime * 0.6), _WindTime * windBox.noiseSpeed * 1.3, cos(_WindTime * 0.8));
                float3 turbulence1 = curlNoise(turbulencePos1) * windBox.noiseStrength * 0.5;
                
                // Second turbulence layer with spiral motion
                float spiralPhase = _WindTime * windBox.noiseSpeed * 0.5 + idx * 0.1;
                float3 turbulencePos2 = (worldPos + splatOffset * 0.3) * windBox.noiseScale * 4.0 + float3(
                    cos(spiralPhase) * 2.0,
                    sin(spiralPhase * 1.3) * 1.5,
                    sin(spiralPhase * 0.7) * 2.5
                );
                float3 turbulence2 = curlNoise(turbulencePos2) * windBox.noiseStrength * 0.3;
                
                // Apply per-splat noise variation with more chaos
                float noiseVariation = 0.3 + (splatRandom2 * 1.4); // More variation range
                windForce += (noiseForce + turbulence1 + turbulence2) * noiseVariation;
            }
            
            // Apply wind force with smooth distance-based falloff (no hard boundaries)
            // Scale force by threshold check - if below threshold, reduce force significantly
            float forceMultiplier = aboveThreshold ? 1.0 : 0.1; // Small force even below threshold for visual effect
            totalWindForce += windForce * windInfluence * forceMultiplier;
        }
        
        // Check if this specific box needs restoration (when influence is very low)
        if (shouldRestore && windInfluence < 0.3) // Restore when far from wind influence
        {
            needsRestoration = true;
        }
    }

    // Calculate forces from all attractors
    for (uint j = 0; j < _AttractorCount; j++)
    {
        AttractorData attractor = _Attractors[j];
        float3 attractorForce = float3(0, 0, 0);
        attractorForce = CalculateAttractorForce(worldPos, attractor);
        totalAttractorForce += attractorForce;

        // Mark as affected by physics system if attractors are present
        inAnyBox = true;
    }

    // Debug: Log total attractor force for first splat every few frames
    if (idx == 0 && length(totalAttractorForce) > 0.0 && (_WindTime * 60) % 60 < 1) {
        // This will help debug if forces are being calculated
    }

    // Apply restoration only if splat is far from both wind boxes AND attractors
    if (needsRestoration)
    {
        // Check if splat is also far from all attractors
        bool farFromAllAttractors = true;
        for (uint j = 0; j < _AttractorCount; j++)
        {
            AttractorData attractor = _Attractors[j];
            if (attractor.enabled > 0.5)
            {
                float3 toAttractor = attractor.position - worldPos;
                float distanceToAttractor = length(toAttractor);
                if (distanceToAttractor <= attractor.range) // Within attractor range
                {
                    farFromAllAttractors = false;
                    break;
                }
            }
        }

        // Only apply restoration if splat is far from both wind boxes and attractors
        if (farFromAllAttractors)
        {
        // Apply restoration force toward the original position with randomness
        float3 originalPos = _SplatOriginalPositions[idx];
        float3 currentPos = LoadSplatPos(idx);
        
        float3 restoreDirection = originalPos - currentPos;
        float restoreDistance = length(restoreDirection);
        
        if (restoreDistance > 0.001) // Apply even for small displacements
        {
            // Generate per-splat random values for restoration chaos
            float restoreRandom1 = frac(sin(dot(float2(idx * 3.7, idx * 1.1), float2(12.9898, 78.233))) * 43758.5453);
            float restoreRandom2 = frac(sin(dot(float2(idx * 0.3, idx * 4.2), float2(12.9898, 78.233))) * 43758.5453);
            float restoreRandom3 = frac(sin(dot(float2(idx * 2.8, idx * 0.9), float2(12.9898, 78.233))) * 43758.5453);
            
            // Find the strongest restoration settings from all applicable boxes
            float maxRestoreForce = 0.0;
            for (uint j = 0; j < _WindBoxCount; j++)
            {
                WindBoxData windBox = _WindBoxes[j];
                if ((windBox.flags & 1) != 0 && (windBox.flags & 4) != 0) // Enabled and restore flag
                {
                    float influence = GetWindInfluence(worldPos, windBox);
                    if (influence < 0.3) // Far from wind influence, needs restoration
                    {
                        float forceMultiplier = windBox.restoreSpeed * windBox.restoreStrength;
                        float maxForce = windBox.windStrength * 10.0; // Even stronger restoration
                        maxRestoreForce = max(maxRestoreForce, min(restoreDistance * forceMultiplier, maxForce));
                    }
                }
            }
            
            if (maxRestoreForce > 0.0)
            {
                // Create organic spiral restoration path instead of straight line
                float spiralTime = _WindTime * 0.4 + idx * 0.05;
                float spiralRadius = restoreDistance * 0.3;
                
                // Create a spiral path toward the original position
                float3 spiralAxis = normalize(cross(restoreDirection, float3(0, 1, 0)));
                if (length(spiralAxis) < 0.1) spiralAxis = float3(1, 0, 0); // Fallback if parallel
                
                float3 spiralOffset = spiralAxis * sin(spiralTime + restoreDistance * 0.5) * spiralRadius;
                spiralOffset += cross(restoreDirection, spiralAxis) * cos(spiralTime + restoreDistance * 0.5) * spiralRadius * 0.7;
                
                // Organic flowing motion toward target
                float3 flowDirection = normalize(restoreDirection + spiralOffset * (restoreDistance / 5.0));
                
                // Add organic wave-like motion to restoration
                float3 waveMotion = float3(
                    sin(_WindTime * 0.8 + idx * 0.1 + restoreDistance * 0.2),
                    cos(_WindTime * 0.6 + idx * 0.15 + restoreDistance * 0.3),
                    sin(_WindTime * 1.1 + idx * 0.08 + restoreDistance * 0.25)
                ) * 0.3;
                
                flowDirection = normalize(flowDirection + waveMotion);
                
                // Make restoration much gentler and more organic
                float restoreStrengthVariation = 0.2 + (restoreRandom1 * 0.6); // More variation
                float distanceFalloff = 1.0 / (1.0 + restoreDistance * 0.1); // Weaker when far away
                float3 restoreForce = flowDirection * (maxRestoreForce * 0.03 * restoreStrengthVariation * distanceFalloff);
                
                totalWindForce += restoreForce;
                inAnyBox = true; // Treat restoration as being "affected" by wind system
            }
        }
        }
    }
    
    // Apply forces to velocity if any forces are present and NOT in turbulence-only mode
    // In turbulence-only mode, forces are calculated for visual effects but positions stay unchanged
    float3 totalForce = totalWindForce + totalAttractorForce;
    if (inAnyBox && length(totalForce) > 0.001 && !turbulenceOnlyMode)
    {
        float3 currentVelocity = _SplatVelocities[idx];

        // Convert world space forces to local space
        float3 localWindForce = mul((float3x3)_MatrixWorldToObject, totalWindForce);
        float3 localAttractorForce = mul((float3x3)_MatrixWorldToObject, totalAttractorForce);
        float3 localTotalForce = localWindForce + localAttractorForce;

        // Apply forces with time scaling
        float deltaTime = 0.016f; // Assume ~60fps for consistent behavior
        currentVelocity += localTotalForce * deltaTime * 2.0; // Stronger multiplier for more noticeable effects

        // Add less damping to maintain movement
        currentVelocity *= 0.995; // Reduced damping

        // Store updated velocity
        _SplatVelocities[idx] = currentVelocity;
    }
    else if (turbulenceOnlyMode && inAnyBox)
    {
        // In turbulence-only mode, apply turbulence as a visual offset around original position
        // This creates visible turbulence without permanent position changes
        float3 originalPos = _SplatOriginalPositions[idx];
        float3 currentPos = LoadSplatPos(idx);
        
        // Generate per-splat random values for individual spread direction
        float splatRandom1 = frac(sin(dot(float2(idx, idx * 1.5), float2(12.9898, 78.233))) * 43758.5453);
        float splatRandom2 = frac(sin(dot(float2(idx * 2.1, idx * 0.7), float2(12.9898, 78.233))) * 43758.5453);
        float splatRandom3 = frac(sin(dot(float2(idx * 1.3, idx * 2.7), float2(12.9898, 78.233))) * 43758.5453);
        
        // Create unique random direction for each splat
        float3 randomDirection = normalize(float3(
            splatRandom1 * 2.0 - 1.0,
            splatRandom2 * 2.0 - 1.0,
            splatRandom3 * 2.0 - 1.0
        ));
        
        // Mix turbulence force with random direction for individual spread
        // Convert world space turbulence to local space
        float3 localTurbulence = mul((float3x3)_MatrixWorldToObject, totalWindForce);
        float turbulenceMagnitude = length(localTurbulence);
        
        // Create spread offset: mix turbulence direction with random direction
        // This ensures each splat spreads in a unique direction
        float3 spreadDirection = normalize(lerp(normalize(localTurbulence), randomDirection, 0.7));
        float3 turbulenceOffset = spreadDirection * turbulenceMagnitude * maxTurbulenceSpread;
        
        float3 newPos = originalPos + turbulenceOffset;
        
        // Store the offset position (creates visible turbulence while staying near original)
        uint fmt = _SplatFormat & 0xFF;
        if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
        {
            uint stride = 12;
            _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(newPos));
        }
        
        // Keep velocity at zero to prevent accumulation
        _SplatVelocities[idx] = float3(0, 0, 0);
    }
    else if (turbulenceOnlyMode)
    {
        // No wind influence - restore position immediately
        float3 originalPos = _SplatOriginalPositions[idx];
        float3 currentPos = LoadSplatPos(idx);
        float restoreDistance = length(originalPos - currentPos);
        
        if (restoreDistance > 0.001)
        {
            uint fmt = _SplatFormat & 0xFF;
            if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
            {
                uint stride = 12;
                _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(originalPos));
            }
        }
        _SplatVelocities[idx] = float3(0, 0, 0);
    }
}

[numthreads(GROUP_SIZE,1,1)]
void CSUpdateWindPhysics(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 currentPos = LoadSplatPos(idx);
    float3 velocity = _SplatVelocities[idx];
    
    // Check per-splat no-gravity flag (bit 0)
    uint flagWordIdx = idx / 32;
    uint flagBitIdx = idx & 31;
    uint flagWord = _SplatAnimFlags.Load(flagWordIdx * 4);
    bool noGravity = (flagWord & (1u << flagBitIdx)) != 0;
    
    // Apply wind physics with dedicated wind settings
    float velocityMagnitude = length(velocity);
    if (velocityMagnitude > 0.001)
    {
        // Add per-splat variation to physics
        float splatRandom1 = frac(sin(dot(float2(idx, idx * 1.5), float2(12.9898, 78.233))) * 43758.5453);
        float splatRandom2 = frac(sin(dot(float2(idx * 2.1, idx * 0.7), float2(12.9898, 78.233))) * 43758.5453);
        
        // Apply wind-specific gravity with per-splat variation (only if not flagged for no-gravity)
        if (!noGravity)
        {
            float gravityVariation = 0.8 + (splatRandom1 * 0.4); // ±20% gravity variation
            velocity.y -= _WindGravity * _DeltaTime * gravityVariation;
        }
        
        // Apply wind-specific damping with per-splat variation (maintains movement longer)
        float dampingVariation = 0.9 + (splatRandom2 * 0.2); // ±10% damping variation
        velocity *= (1.0 - _WindDamping * _DeltaTime * dampingVariation);
        
        // Wind-specific minimum velocity threshold
        if (length(velocity) < _WindMinVelocity)
        {
            velocity = float3(0, 0, 0);
        }
        
        // Update position if still moving
        if (length(velocity) > 0.001)
        {
            float3 newPos = currentPos + velocity * _DeltaTime;
            
            // Update position in buffer
            uint fmt = _SplatFormat & 0xFF;
            if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
            {
                uint stride = 12;
                _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(newPos));
            }
        }
    }
    
    // Always store updated values
    _SplatVelocities[idx] = velocity;
    _SplatPrevPositions[idx] = currentPos;
}

[numthreads(GROUP_SIZE,1,1)]
void CSInitOriginalPositions(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
        
    // Copy current splat position to original positions buffer
    float3 currentPos = LoadSplatPos(idx);
    _SplatOriginalPositions[idx] = currentPos;
}

[numthreads(GROUP_SIZE,1,1)]
void CSDirectRestorePositions(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
        
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    bool shouldRestore = false;
    float restoreSpeed = 1.0;
    
    // Check if splat should be restored (outside any restoration-enabled wind box)
    for (uint i = 0; i < _WindBoxCount; i++)
    {
        WindBoxData windBox = _WindBoxes[i];
        
        // Skip disabled boxes
        if ((windBox.flags & 1) == 0)
            continue;
            
        // Check if this box has restoration enabled
        bool hasRestore = (windBox.flags & 4) != 0;
        if (!hasRestore)
            continue;
            
        bool inBox = IsInWindBox(worldPos, windBox);
        
        // If outside this restoration box, mark for restoration
        if (!inBox)
        {
            shouldRestore = true;
            restoreSpeed = max(restoreSpeed, windBox.restoreSpeed);
        }
        else
        {
            // If inside any restoration box, don't restore
            shouldRestore = false;
            break;
        }
    }
    
    // Directly restore position if needed
    if (shouldRestore)
    {
        float3 originalPos = _SplatOriginalPositions[idx];
        float3 currentPos = LoadSplatPos(idx);
        
        float3 restoreDirection = originalPos - currentPos;
        float restoreDistance = length(restoreDirection);
        
        if (restoreDistance > 0.001)
        {
            // Move directly towards original position based on restore speed - much more gradual
            float moveAmount = min(restoreDistance, restoreSpeed * 0.01); // Move up to 1% of restore speed per frame
            float3 newPos = currentPos + normalize(restoreDirection) * moveAmount;
            
            // Update position directly in buffer
            uint fmt = _SplatFormat & 0xFF;
            if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
            {
                uint stride = 12;
                _SplatPos.Store3(idx * stride, PackFloat3AsUintBits(newPos));
            }
            
            // Clear velocity to prevent interference
            _SplatVelocities[idx] = float3(0, 0, 0);
        }
    }
}

// GPU-based sphere deletion for VR optimization with falloff and noise
float3 _DeletionSphereCenter;
float _DeletionSphereRadius;
float _DeletionFalloff;
float _DeletionNoiseStrength;
float _DeletionNoiseScale;
float _DeletionNoiseTime;
float3 _DeletionCameraDir;     // Camera forward direction for view-culling
float _DeletionCameraAngle;    // Cos of max angle (0 = disabled, 0.5 = 60 deg, 0.707 = 45 deg)

// Color filter for deletion
int _UseColorFilter;
float4 _DeletionColorFilter;   // RGB = target color, A unused
float _DeletionColorThreshold; // 0-1 threshold for color matching

// Helper to check if splat color matches filter
bool MatchesColorFilter(uint splatIdx)
{
    bool matches = true;
    if (_UseColorFilter != 0)
    {
        uint3 pixelCoord = SplatIndexToPixelIndex(splatIdx);
        float4 splatColor = _SplatColor.Load(int3(pixelCoord.xy, 0));
        float3 colorDiff = abs(splatColor.rgb - _DeletionColorFilter.rgb);
        float colorDist = (colorDiff.r + colorDiff.g + colorDiff.b) / 3.0;
        matches = colorDist <= _DeletionColorThreshold;
    }
    return matches;
}

// Clone brush variables
float3 _CloneSourceCenter;
float3 _CloneTargetCenter;
float _CloneRadius;
float _CloneFalloff;
uint _CloneDestStartIndex;
uint _CloneMaxCount;
RWStructuredBuffer<uint> _CloneCountBuffer; // [0] = count, [1..] = source indices

// Helper to get SH data stride based on format
uint SHDataStride(uint shFormat)
{
    if (shFormat == VECTOR_FMT_32F)
        return 192; // 15*3 fp32, rounded up
    else if (shFormat == VECTOR_FMT_16 || shFormat > VECTOR_FMT_6)
        return 96; // 15*3 fp16, rounded up
    else if (shFormat == VECTOR_FMT_11)
        return 60; // 15x uint
    else if (shFormat == VECTOR_FMT_6)
        return 32; // 15x ushort, rounded up
    return 96; // default
}

// Hash function for pseudo-random numbers
float hash13(float3 p3)
{
    p3 = frac(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return frac((p3.x + p3.y) * p3.z);
}

// 3D Perlin-like noise
float noise3d(float3 p)
{
    float3 i = floor(p);
    float3 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);
    
    float n = i.x + i.y * 157.0 + i.z * 113.0;
    return lerp(
        lerp(lerp(hash13(float3(n, 0, 0)), hash13(float3(n + 1, 0, 0)), f.x),
             lerp(hash13(float3(n + 157, 0, 0)), hash13(float3(n + 158, 0, 0)), f.x), f.y),
        lerp(lerp(hash13(float3(n + 113, 0, 0)), hash13(float3(n + 114, 0, 0)), f.x),
             lerp(hash13(float3(n + 270, 0, 0)), hash13(float3(n + 271, 0, 0)), f.x), f.y),
        f.z);
}

[numthreads(GROUP_SIZE,1,1)]
void CSMarkSphereForDeletion(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Get splat position in local space
    float3 splatPos = LoadSplatPos(idx);
    
    // Transform to world space
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Calculate distance from sphere center
    float distance = length(worldPos - _DeletionSphereCenter);
    
    // Early exit if completely outside
    if (distance > _DeletionSphereRadius)
        return;
    
    // Camera-facing culling: only delete splats in front of camera relative to brush
    if (_DeletionCameraAngle > 0.001)
    {
        // Direction from brush center to splat
        float3 toSplat = normalize(worldPos - _DeletionSphereCenter);
        // Check if splat is in front of the brush from camera's view
        float facingDot = dot(toSplat, _DeletionCameraDir);
        // Skip splats that are behind the brush (facing away from camera)
        if (facingDot < -_DeletionCameraAngle)
            return;
    }
    
    // Color filter check - skip if color doesn't match filter
    if (!MatchesColorFilter(idx))
        return;
    
    // Calculate normalized distance (0 at center, 1 at edge)
    float normalizedDist = distance / _DeletionSphereRadius;
    
    // CORE ZONE: Always delete splats in the inner portion (no randomness)
    // Core radius is 1 - falloff (so falloff=0 means 100% core, falloff=1 means 0% core)
    float coreRadius = 1.0 - _DeletionFalloff;
    
    // If in core zone OR no falloff, always delete
    if (normalizedDist <= coreRadius || _DeletionFalloff < 0.01)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
        return;
    }
    
    // FALLOFF ZONE: Probabilistic deletion in the outer ring
    // Map distance from [coreRadius, 1] to [0, 1]
    float falloffDist = (normalizedDist - coreRadius) / (1.0 - coreRadius);
    
    // Falloff curve: 1 at core edge, 0 at outer edge
    float falloffCurve = 1.0 - pow(falloffDist, 2.0);
    
    // Add noise for organic deletion patterns
    float noiseValue = 0.0;
    if (_DeletionNoiseStrength > 0.0)
    {
        // Sample noise at world position with time offset
        float3 noisePos = worldPos * _DeletionNoiseScale + float3(_DeletionNoiseTime, 0, 0);
        noiseValue = noise3d(noisePos);
        
        // Add multiple octaves for more detail
        noiseValue += noise3d(noisePos * 2.0) * 0.5;
        noiseValue += noise3d(noisePos * 4.0) * 0.25;
        noiseValue /= 1.75; // Normalize
        
        // Remap noise from [0,1] to [-strength, +strength]
        noiseValue = (noiseValue * 2.0 - 1.0) * _DeletionNoiseStrength;
    }
    
    // Combine falloff and noise
    float deletionProbability = saturate(falloffCurve + noiseValue);
    
    // Use hash-based pseudo-random to determine if this splat should be deleted
    float randomThreshold = hash13(worldPos + float3(idx * 0.1, 0, 0));
    
    // Mark for deletion if probability exceeds threshold
    if (deletionProbability > randomThreshold)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    }
}

// Restore splats within a sphere (undo deletion)
[numthreads(GROUP_SIZE,1,1)]
void CSRestoreSphereFromDeletion(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Get splat position in local space
    float3 splatPos = LoadSplatPos(idx);
    
    // Transform to world space
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Calculate distance from sphere center
    float distance = length(worldPos - _DeletionSphereCenter);
    
    // Only restore if inside sphere
    if (distance <= _DeletionSphereRadius)
    {
        // Clear the deleted bit (restore the splat)
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx));
    }
}

// Delete splats in screen circle with depth filtering (backface culling)
// Uses the same logic as CSSelectSplatsInScreenCircle with backface culling
// _SelectionCircleCenterPx is in GUI coordinates (Y=0 at top)
[numthreads(GROUP_SIZE,1,1)]
void CSDeleteSplatsInScreenCircleWithDepth (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    float3 pos = LoadSplatPos(idx);
    if (IsSplatCut(pos))
        return;

    float3 centerWorldPos = mul(_MatrixObjectToWorld, float4(pos,1)).xyz;
    float4 centerClipPos = mul(_MatrixVP, float4(centerWorldPos, 1));
    if (centerClipPos.w <= 0)
        return;

    // Convert clip space to pixel coordinates - same as CSSelectSplatsInScreenCircle
    // Clip: X [-1,1] left to right, Y [-1,1] bottom to top
    // GUI coords: Y=0 at top, so we need Y inverted
    float2 ndc = centerClipPos.xy / centerClipPos.w;
    float2 pixelPos;
    pixelPos.x = (ndc.x * 0.5 + 0.5) * _VecScreenParams.x;
    pixelPos.y = (1.0 - (ndc.y * 0.5 + 0.5)) * _VecScreenParams.y; // Y flipped for GUI coords
    
    float2 d = pixelPos - _SelectionCircleCenterPx;
    float distSq = dot(d, d);
    float radiusSq = _SelectionCircleRadiusPx * _SelectionCircleRadiusPx;
    if (distSq > radiusSq)
        return;
    
    // Backface culling: only delete splats at or near the minimum depth (front surface)
    if (_BackfaceCulling)
    {
        uint minDepthSortable = _SelectionMinDepth.Load(0);
        float minDepth = SortableUintToFloat(minDepthSortable);
        if (centerClipPos.w > (minDepth + _SelectionDepthEpsilon))
            return;
    }
    
    // Color filter check - skip if color doesn't match filter
    if (!MatchesColorFilter(idx))
        return;

    // Calculate normalized distance for falloff (0 at center, 1 at edge)
    float dist = sqrt(distSq);
    float normalizedDist = dist / _SelectionCircleRadiusPx;
    float coreRadius = 1.0 - _DeletionFalloff;
    
    // Core zone: always delete
    if (normalizedDist <= coreRadius || _DeletionFalloff < 0.01)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
        return;
    }
    
    // Falloff zone: probabilistic deletion based on noise
    float falloffT = (normalizedDist - coreRadius) / _DeletionFalloff;
    float baseProbability = 1.0 - falloffT;
    
    if (_DeletionNoiseStrength > 0.01)
    {
        float noise = frac(sin(dot(centerWorldPos.xyz * _DeletionNoiseScale + _DeletionNoiseTime, float3(12.9898, 78.233, 45.5432))) * 43758.5453);
        float noiseOffset = (noise - 0.5) * 2.0 * _DeletionNoiseStrength;
        baseProbability += noiseOffset;
    }
    
    float random = frac(sin(dot(float2(idx, _DeletionNoiseTime), float2(12.9898, 78.233))) * 43758.5453);
    if (random < baseProbability)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    }
}

// Delete splats within a cylinder (view-ray based - deletes what's visually under brush)
[numthreads(GROUP_SIZE,1,1)]
void CSMarkCylinderForDeletion(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Vector from brush center to splat
    float3 toSplat = worldPos - _DeletionSphereCenter;
    
    // Project onto view direction to get distance along ray
    // Positive = splat is behind brush (further from camera)
    // Negative = splat is in front of brush (closer to camera)
    float alongRay = dot(toSplat, _DeletionCameraDir);
    
    // Only delete splats in front of or at the brush position (not behind)
    if (alongRay > 0)
        return;
    
    // Get perpendicular distance from ray (this is the cylinder radius check)
    float3 perpendicular = toSplat - _DeletionCameraDir * alongRay;
    float perpDist = length(perpendicular);
    
    // Early exit if outside cylinder radius
    if (perpDist > _DeletionSphereRadius)
        return;
    
    // Color filter check - skip if color doesn't match filter
    if (!MatchesColorFilter(idx))
        return;
    
    // Calculate normalized distance (0 at center, 1 at edge)
    float normalizedDist = perpDist / _DeletionSphereRadius;
    
    // Core zone calculation
    float coreRadius = 1.0 - _DeletionFalloff;
    
    if (normalizedDist <= coreRadius || _DeletionFalloff < 0.01)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
        return;
    }
    
    // Falloff zone
    float falloffDist = (normalizedDist - coreRadius) / (1.0 - coreRadius);
    float falloffCurve = 1.0 - pow(falloffDist, 2.0);
    
    float noiseValue = 0.0;
    if (_DeletionNoiseStrength > 0.0)
    {
        float3 noisePos = worldPos * _DeletionNoiseScale + float3(_DeletionNoiseTime, 0, 0);
        noiseValue = noise3d(noisePos);
        noiseValue += noise3d(noisePos * 2.0) * 0.5;
        noiseValue += noise3d(noisePos * 4.0) * 0.25;
        noiseValue /= 1.75;
        noiseValue = (noiseValue * 2.0 - 1.0) * _DeletionNoiseStrength;
    }
    
    float deletionProbability = saturate(falloffCurve + noiseValue);
    float randomThreshold = hash13(worldPos + float3(idx * 0.1, 0, 0));
    
    if (deletionProbability > randomThreshold)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
    }
}

// Restore splats within a cylinder (only in front of brush)
[numthreads(GROUP_SIZE,1,1)]
void CSRestoreCylinderFromDeletion(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    float3 toSplat = worldPos - _DeletionSphereCenter;
    float alongRay = dot(toSplat, _DeletionCameraDir);
    
    // Only restore splats in front of or at the brush position
    if (alongRay > 0)
        return;
    
    float3 perpendicular = toSplat - _DeletionCameraDir * alongRay;
    float perpDist = length(perpendicular);
    
    if (perpDist <= _DeletionSphereRadius)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _SplatDeletedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx));
    }
}

// Select/deselect splats within a sphere (paint selection brush)
float3 _SelectionSphereCenter;
float _SelectionSphereRadius;
int _SelectionSphereMode; // 1 = add, 0 = subtract

[numthreads(GROUP_SIZE,1,1)]
void CSSelectSplatsInSphere(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 splatPos = LoadSplatPos(idx);
    
    // Check if splat is cut
    if (IsSplatCut(splatPos))
        return;
    
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    float distance = length(worldPos - _SelectionSphereCenter);
    
    if (distance <= _SelectionSphereRadius)
    {
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        if (_SelectionSphereMode != 0)
            _SplatSelectedBits.InterlockedOr(wordIdx * 4, 1u << bitIdx);
        else
            _SplatSelectedBits.InterlockedAnd(wordIdx * 4, ~(1u << bitIdx));
    }
}

// Pass 1: Count splats in source sphere and store their indices
[numthreads(256, 1, 1)]
void CSCloneSplatsInSphere(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 splatPos = LoadSplatPos(idx);
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Check if splat is in source sphere
    float distance = length(worldPos - _CloneSourceCenter);
    if (distance > _CloneRadius)
        return;
    
    // Calculate normalized distance (0 at center, 1 at edge)
    float normalizedDist = distance / _CloneRadius;
    
    // CORE ZONE: Always include splats in the inner portion
    // Core radius is 1 - falloff (so falloff=0 means 100% core, falloff=1 means 0% core)
    float coreRadius = 1.0 - _CloneFalloff;
    
    bool shouldClone = false;
    
    // If in core zone OR no falloff, always include
    if (normalizedDist <= coreRadius || _CloneFalloff < 0.01)
    {
        shouldClone = true;
    }
    else
    {
        // FALLOFF ZONE: Probabilistic inclusion in the outer ring
        float falloffDist = (normalizedDist - coreRadius) / (1.0 - coreRadius);
        float falloffCurve = 1.0 - pow(falloffDist, 2.0);
        
        // Use hash-based probability for consistent selection
        float randomThreshold = hash13(worldPos + float3(idx * 0.1, 0, 0));
        shouldClone = (falloffCurve > randomThreshold);
    }
    
    if (shouldClone)
    {
        // Atomic increment to get unique slot
        uint slot;
        InterlockedAdd(_CloneCountBuffer[0], 1, slot);
        
        // Store source index if within max count
        if (slot < _CloneMaxCount)
        {
            _CloneCountBuffer[slot + 1] = idx;
        }
    }
}

// Pass 2: Copy splat data with offset
[numthreads(256, 1, 1)]
void CSCopySplatsWithOffset(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    uint cloneCount = min(_CloneCountBuffer[0], _CloneMaxCount);
    if (idx >= cloneCount)
        return;
    
    uint srcIdx = _CloneCountBuffer[idx + 1];
    uint dstIdx = _CloneDestStartIndex + idx;
    
    if (srcIdx >= _SplatCount)
        return;
    
    // Load source LOCAL position (LoadSplatPos returns local space)
    float3 srcLocalPos = LoadSplatPos(srcIdx);
    
    // Calculate offset: convert world offset to local space
    float3 worldOffset = _CloneTargetCenter - _CloneSourceCenter;
    float3 localOffset = mul(_MatrixWorldToObject, float4(worldOffset, 0)).xyz;
    
    // Apply offset to get destination LOCAL position
    float3 dstPos = srcLocalPos + localOffset;
    
    // Write position in 32F format (destination area is expanded in 32F)
    uint posStride = 12;
    _SplatPos.Store3(dstIdx * posStride, PackFloat3AsUintBits(dstPos));
    
    // Copy other data (rotation, scale) - need to handle various formats
    uint scaleFmt = (_SplatFormat >> 8) & 0xFF;
    uint srcOtherStride = 4; // rotation is always 10.10.10.2
    if (scaleFmt == VECTOR_FMT_32F)
        srcOtherStride += 12;
    else if (scaleFmt == VECTOR_FMT_16)
        srcOtherStride += 6;
    else if (scaleFmt == VECTOR_FMT_11)
        srcOtherStride += 4;
    else if (scaleFmt == VECTOR_FMT_6)
        srcOtherStride += 2;
    
    uint shFormat = (_SplatFormat >> 16) & 0xFF;
    if (shFormat > VECTOR_FMT_6)
        srcOtherStride += 2;
    
    // Read rotation (always 10.10.10.2 format)
    uint rotVal = _SplatOther.Load(srcIdx * srcOtherStride);
    
    // Read and decode scale
    float3 scale = LoadAndDecodeVector(_SplatOther, srcIdx * srcOtherStride + 4, scaleFmt);
    
    // Write in 32F format (destination uses 32F)
    uint dstOtherStride = 4 + 12; // rotation + 32F scale
    _SplatOther.Store4(dstIdx * dstOtherStride, uint4(
        rotVal,
        asuint(scale.x),
        asuint(scale.y),
        asuint(scale.z)));
    
    // Copy SH data
    uint shFmt = (_SplatFormat >> 16) & 0xFF;
    uint srcShStride = 96;
    srcShStride = SHDataStride(shFmt);
    uint dstShStride = srcShStride; // Use same format for destination
    
    // Copy SH data bytes
    for (uint i = 0; i < srcShStride / 4; i++)
    {
        uint val = _SplatSH.Load(srcIdx * srcShStride + i * 4);
        _SplatSH.Store(dstIdx * dstShStride + i * 4, val);
    }
}

// Simple splat painting kernel - only writes to 3 buffers to avoid UAV limit
uint _PaintSplatIndex;
float3 _PaintPosition;
float4 _PaintRotation;
float3 _PaintScale;
float4 _PaintColor;
float _PaintOpacity;
RWTexture2D<float4> _PaintColorTexture;

[numthreads(1,1,1)]
void CSPaintSplat(uint3 id : SV_DispatchThreadID)
{
    uint idx = _PaintSplatIndex;
    if (idx >= _SplatCount)
        return;
    
    // Write position (assuming 32F format)
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(_PaintPosition));
        
        // Write rotation and scale
        uint otherStride = 4 + 12;
        uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(_PaintRotation));
        _SplatOther.Store4(idx * otherStride, uint4(
            rotVal,
            asuint(_PaintScale.x),
            asuint(_PaintScale.y),
            asuint(_PaintScale.z)));
        
        // Write color to texture
        uint3 pixelIndex = SplatIndexToPixelIndex(idx);
        _PaintColorTexture[pixelIndex.xy] = _PaintColor;
    }
}

// Batched splat painting - processes multiple splats in one dispatch
#pragma kernel CSPaintSplatBatch

StructuredBuffer<float3> _PaintBatchPositions;
StructuredBuffer<float4> _PaintBatchColors;
StructuredBuffer<float> _PaintBatchSizes;
uint _PaintBatchStartIndex;
uint _PaintBatchCount;

[numthreads(64,1,1)]
void CSPaintSplatBatch(uint3 id : SV_DispatchThreadID)
{
    uint batchIdx = id.x;
    if (batchIdx >= _PaintBatchCount)
        return;
    
    uint splatIdx = _PaintBatchStartIndex + batchIdx;
    if (splatIdx >= _SplatCount)
        return;
    
    float3 position = _PaintBatchPositions[batchIdx];
    float4 color = _PaintBatchColors[batchIdx];
    float size = _PaintBatchSizes[batchIdx];
    
    // Apply density to alpha
    color.a = clamp(color.a * _PaintOpacity, 0, 1);
    
    // Write position (assuming 32F format after EditSetSplatCount)
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        _SplatPos.Store3(splatIdx * posStride, PackFloat3AsUintBits(position));
        
        // Write rotation (identity) and scale
        uint otherStride = 4 + 12;
        float4 identityRot = float4(0, 0, 0, 1);
        uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(identityRot));
        _SplatOther.Store4(splatIdx * otherStride, uint4(
            rotVal,
            asuint(size),
            asuint(size),
            asuint(size)));
        
        // Write color to texture
        uint3 pixelIndex = SplatIndexToPixelIndex(splatIdx);
        _PaintColorTexture[pixelIndex.xy] = color;
    }
}

// GPU-based paint generation - generates random positions entirely on GPU
#pragma kernel CSPaintSplatsGPU

float3 _PaintCenter;        // World-space paint center
float _PaintScatterRadius;  // Local-space scatter radius
float _PaintSplatSize;      // Size of each splat
float4 _PaintBaseColor;     // Base color for painting
float _PaintColorVariation; // 0-1 for HSV variation
float3 _PaintRightDir;      // Perpendicular to view (local space)
float3 _PaintUpDir;         // Perpendicular to view (local space)
uint _PaintSeed;            // Random seed based on time
uint _PaintStartIndex;      // Starting index for splats
uint _PaintSplatCount;      // Number of splats to generate

// Texture paint variables
Texture2D<float4> _PaintSourceTexture;
float _PaintTextureTileScale;
float _PaintTextureRotation;

// Fast GPU random using PCG
uint pcg_hash(uint input)
{
    uint state = input * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float pcg_random(uint seed)
{
    return float(pcg_hash(seed)) / 4294967295.0;
}

float3 RGBtoHSV(float3 rgb)
{
    float cmax = max(rgb.r, max(rgb.g, rgb.b));
    float cmin = min(rgb.r, min(rgb.g, rgb.b));
    float delta = cmax - cmin;
    
    float h = 0;
    if (delta > 0.0001)
    {
        if (cmax == rgb.r) h = fmod((rgb.g - rgb.b) / delta, 6.0) / 6.0;
        else if (cmax == rgb.g) h = ((rgb.b - rgb.r) / delta + 2.0) / 6.0;
        else h = ((rgb.r - rgb.g) / delta + 4.0) / 6.0;
    }
    if (h < 0) h += 1.0;
    
    float s = (cmax > 0) ? delta / cmax : 0;
    float v = cmax;
    
    return float3(h, s, v);
}

float3 HSVtoRGB(float3 hsv)
{
    float h = hsv.x * 6.0;
    float s = hsv.y;
    float v = hsv.z;
    
    float c = v * s;
    float x = c * (1.0 - abs(fmod(h, 2.0) - 1.0));
    float m = v - c;
    
    float3 rgb;
    if (h < 1) rgb = float3(c, x, 0);
    else if (h < 2) rgb = float3(x, c, 0);
    else if (h < 3) rgb = float3(0, c, x);
    else if (h < 4) rgb = float3(0, x, c);
    else if (h < 5) rgb = float3(x, 0, c);
    else rgb = float3(c, 0, x);
    
    return rgb + m;
}

[numthreads(64,1,1)]
void CSPaintSplatsGPU(uint3 id : SV_DispatchThreadID)
{
    uint batchIdx = id.x;
    if (batchIdx >= _PaintSplatCount)
        return;
    
    uint splatIdx = _PaintStartIndex + batchIdx;
    if (splatIdx >= _SplatCount)
        return;
    
    // Generate unique seed for this splat
    uint seed = _PaintSeed + batchIdx * 1013904223u;
    
    // Random angle and distance (uniform disk distribution)
    float angle = pcg_random(seed) * 6.28318530718; // 2*PI
    seed = pcg_hash(seed);
    float dist = sqrt(pcg_random(seed)) * _PaintScatterRadius;
    seed = pcg_hash(seed);
    
    // Calculate position in local space
    float3 offset = _PaintRightDir * (cos(angle) * dist) + _PaintUpDir * (sin(angle) * dist);
    float3 position = _PaintCenter + offset;
    
    // Color with variation
    float4 color = _PaintBaseColor;
    if (_PaintColorVariation > 0)
    {
        float3 hsv = RGBtoHSV(color.rgb);
        float hVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.2;
        seed = pcg_hash(seed);
        float sVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.4;
        seed = pcg_hash(seed);
        float vVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.3;
        
        hsv.x = frac(hsv.x + hVar);
        hsv.y = saturate(hsv.y + sVar);
        hsv.z = saturate(hsv.z + vVar);
        color.rgb = HSVtoRGB(hsv);
    }
    
    // Apply opacity
    color.a = clamp(color.a * _PaintOpacity, 0, 1);
    
    // Write position (assuming 32F format)
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        _SplatPos.Store3(splatIdx * posStride, PackFloat3AsUintBits(position));
        
        // Write rotation (identity) and scale
        uint otherStride = 4 + 12;
        float4 identityRot = float4(0, 0, 0, 1);
        uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(identityRot));
        _SplatOther.Store4(splatIdx * otherStride, uint4(
            rotVal,
            asuint(_PaintSplatSize),
            asuint(_PaintSplatSize),
            asuint(_PaintSplatSize)));
        
        // Write color
        uint3 pixelIndex = SplatIndexToPixelIndex(splatIdx);
        _PaintColorTexture[pixelIndex.xy] = color;
    }
}

// Texture-based paint kernel
#pragma kernel CSPaintSplatsFromTexture

[numthreads(64,1,1)]
void CSPaintSplatsFromTexture(uint3 id : SV_DispatchThreadID)
{
    uint batchIdx = id.x;
    if (batchIdx >= _PaintSplatCount)
        return;
    
    uint splatIdx = _PaintStartIndex + batchIdx;
    if (splatIdx >= _SplatCount)
        return;
    
    // Generate unique seed for this splat
    uint seed = _PaintSeed + batchIdx * 1013904223u;
    
    // Random angle and distance (uniform disk distribution)
    float angle = pcg_random(seed) * 6.28318530718; // 2*PI
    seed = pcg_hash(seed);
    float dist = sqrt(pcg_random(seed)) * _PaintScatterRadius;
    seed = pcg_hash(seed);
    
    // Calculate position in local space
    float cosAngle = cos(angle);
    float sinAngle = sin(angle);
    float3 offset = _PaintRightDir * (cosAngle * dist) + _PaintUpDir * (sinAngle * dist);
    float3 position = _PaintCenter + offset;
    
    // Calculate UV from position within brush radius
    float u = cosAngle * (dist / _PaintScatterRadius) * 0.5 + 0.5;
    float v = sinAngle * (dist / _PaintScatterRadius) * 0.5 + 0.5;
    
    // Apply tile scale
    u *= _PaintTextureTileScale;
    v *= _PaintTextureTileScale;
    
    // Apply rotation
    if (abs(_PaintTextureRotation) > 0.001)
    {
        float cosRot = cos(_PaintTextureRotation);
        float sinRot = sin(_PaintTextureRotation);
        float cu = u - 0.5;
        float cv = v - 0.5;
        u = cu * cosRot - cv * sinRot + 0.5;
        v = cu * sinRot + cv * cosRot + 0.5;
    }
    
    // Wrap UVs
    u = frac(u);
    v = frac(v);
    
    // Get texture dimensions and sample using Load
    uint texW, texH;
    _PaintSourceTexture.GetDimensions(texW, texH);
    int2 texCoord = int2(u * texW, v * texH);
    texCoord = clamp(texCoord, int2(0, 0), int2(texW - 1, texH - 1));
    float4 color = _PaintSourceTexture.Load(int3(texCoord, 0));
    
    // Apply color variation if set
    if (_PaintColorVariation > 0)
    {
        float3 hsv = RGBtoHSV(color.rgb);
        float hVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.2;
        seed = pcg_hash(seed);
        float sVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.4;
        seed = pcg_hash(seed);
        float vVar = (pcg_random(seed) - 0.5) * _PaintColorVariation * 0.3;
        
        hsv.x = frac(hsv.x + hVar);
        hsv.y = saturate(hsv.y + sVar);
        hsv.z = saturate(hsv.z + vVar);
        color.rgb = HSVtoRGB(hsv);
    }
    
    // Apply opacity
    color.a = clamp(color.a * _PaintOpacity, 0, 1);
    
    // Write position (assuming 32F format)
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
    {
        uint posStride = 12;
        _SplatPos.Store3(splatIdx * posStride, PackFloat3AsUintBits(position));
        
        // Write rotation (identity) and scale
        uint otherStride = 4 + 12;
        float4 identityRot = float4(0, 0, 0, 1);
        uint rotVal = EncodeQuatToNorm10(PackSmallest3Rotation(identityRot));
        _SplatOther.Store4(splatIdx * otherStride, uint4(
            rotVal,
            asuint(_PaintSplatSize),
            asuint(_PaintSplatSize),
            asuint(_PaintSplatSize)));
        
        // Write color
        uint3 pixelIndex = SplatIndexToPixelIndex(splatIdx);
        _PaintColorTexture[pixelIndex.xy] = color;
    }
}

// Decal projection variables
Texture2D<float4> _DecalTexture;
SamplerState sampler_DecalTexture;
RWTexture2D<float4> _DecalColorTexture;

float4x4 _DecalWorldToProjector;
float4x4 _DecalProjectorToWorld;
float3 _DecalBoxSize;
int _DecalProjectionMode; // 0 = Box, 1 = Frustum
int _DecalBlendMode; // 0 = Replace, 1 = Multiply, 2 = Additive, 3 = Overlay, 4 = AlphaBlend
float _DecalOpacity;
float4 _DecalTintColor;

float _DecalFrustumFOV;
float _DecalFrustumNear;
float _DecalFrustumFar;

int _DecalUseNormalFiltering;
float _DecalNormalThreshold;
int _DecalUseDepthFade;
float _DecalDepthFadeStart;
float _DecalDepthFadeEnd;

// Helper function to check if point is inside projection volume and get UV
bool GetDecalUV(float3 worldPos, out float2 uv, out float depth)
{
    uv = float2(0, 0);
    depth = 0;
    
    if (_DecalProjectionMode == 0) // Box projection
    {
        // Transform to projector local space
        float3 localPos = mul(_DecalWorldToProjector, float4(worldPos, 1)).xyz;
        
        // Check if inside box
        if (any(abs(localPos) > _DecalBoxSize * 0.5))
            return false;
        
        // Calculate UVs from box position (XY plane projection)
        uv = (localPos.xy / _DecalBoxSize.xy) + 0.5;
        depth = (localPos.z / _DecalBoxSize.z) * 0.5 + 0.5;
        
        return true;
    }
    else // Frustum projection
    {
        // Transform to projector space
        float3 localPos = mul(_DecalWorldToProjector, float4(worldPos, 1)).xyz;
        
        // Check if in front of near plane and behind far plane (looking down -Z)
        if (localPos.z > -_DecalFrustumNear || localPos.z < -_DecalFrustumFar)
            return false;
        
        // Calculate perspective projection
        float viewZ = -localPos.z;
        float halfHeight = viewZ * tan(_DecalFrustumFOV * 0.5 * 0.0174533); // deg to rad
        float halfWidth = halfHeight;
        
        // Check if inside frustum bounds
        if (abs(localPos.x) > halfWidth || abs(localPos.y) > halfHeight)
            return false;
        
        // Calculate UVs
        uv.x = (localPos.x / halfWidth) * 0.5 + 0.5;
        uv.y = (localPos.y / halfHeight) * 0.5 + 0.5;
        depth = (viewZ - _DecalFrustumNear) / (_DecalFrustumFar - _DecalFrustumNear);
        
        return true;
    }
}

// Blend modes - opacity always controls transparency via lerp
float4 BlendDecalColor(float4 baseColor, float4 decalColor, int blendMode, float opacity)
{
    float3 blendedRGB = baseColor.rgb;
    
    if (blendMode == 0) // Replace
    {
        blendedRGB = decalColor.rgb;
    }
    else if (blendMode == 1) // Multiply
    {
        // Multiply with 2x compensation to prevent excessive darkening
        blendedRGB = baseColor.rgb * decalColor.rgb * 2.0;
    }
    else if (blendMode == 2) // Additive
    {
        // Additive with 0.5x strength to prevent over-brightness
        blendedRGB = saturate(baseColor.rgb + decalColor.rgb * 0.5);
    }
    else if (blendMode == 3) // Overlay
    {
        blendedRGB.r = baseColor.r < 0.5 ? (2.0 * baseColor.r * decalColor.r) : (1.0 - 2.0 * (1.0 - baseColor.r) * (1.0 - decalColor.r));
        blendedRGB.g = baseColor.g < 0.5 ? (2.0 * baseColor.g * decalColor.g) : (1.0 - 2.0 * (1.0 - baseColor.g) * (1.0 - decalColor.g));
        blendedRGB.b = baseColor.b < 0.5 ? (2.0 * baseColor.b * decalColor.b) : (1.0 - 2.0 * (1.0 - baseColor.b) * (1.0 - decalColor.b));
    }
    else if (blendMode == 4) // Alpha Blend
    {
        // Use decal alpha channel in addition to opacity
        blendedRGB = lerp(baseColor.rgb, decalColor.rgb, decalColor.a);
    }
    
    // Use linear opacity so the Inspector slider maps directly to blend strength.
    float blendOpacity = saturate(opacity);

    // Apply opacity as final transparency lerp for all modes.
    float4 result;
    result.rgb = lerp(baseColor.rgb, blendedRGB, blendOpacity);
    result.a = baseColor.a;
    
    return result;
}

[numthreads(GROUP_SIZE,1,1)]
void CSApplyDecalProjection(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Get splat position in local space
    float3 splatPos = LoadSplatPos(idx);
    
    // Transform to world space
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Check if splat is in projection volume and get UV
    float2 uv = float2(0, 0);
    float depth = 0;
    bool hasDecalUV = false;
    hasDecalUV = GetDecalUV(worldPos, uv, depth);
    if (!hasDecalUV)
        return;
    
    // Apply depth fade if enabled
    float depthFade = 1.0;
    if (_DecalUseDepthFade != 0)
    {
        depthFade = 1.0 - smoothstep(_DecalDepthFadeStart, _DecalDepthFadeEnd, depth);
        if (depthFade < 0.01)
            return;
    }
    
    // Sample decal texture
    float4 decalColor = _DecalTexture.SampleLevel(sampler_DecalTexture, uv, 0);
    
    // Apply tint color
    decalColor *= _DecalTintColor;
    
    // Get current splat color
    uint3 pixelIndex = SplatIndexToPixelIndex(idx);
    float4 currentColor = _DecalColorTexture[pixelIndex.xy];
    
    // Blend colors
    float finalOpacity = _DecalOpacity * depthFade;
    float4 blendedColor = BlendDecalColor(currentColor, decalColor, _DecalBlendMode, finalOpacity);
    
    // Write back to texture
    _DecalColorTexture[pixelIndex.xy] = blendedColor;
}

// Equirectangular projection variables
Texture2D<float4> _EquirectTexture;
SamplerState sampler_EquirectTexture;
RWTexture2D<float4> _EquirectColorTexture;

// High quality sampler for equirectangular textures
SamplerState sampler_linear_repeat
{
    Filter = MIN_MAG_MIP_LINEAR;
    AddressU = Wrap;
    AddressV = Clamp;
    MaxAnisotropy = 16;
};

float3 _EquirectProjectorPosition;
float3 _EquirectProjectorScale;
float4 _EquirectProjectorRotation; // Quaternion
float _EquirectProjectionRadius;
int _EquirectBlendMode;
float _EquirectOpacity;
float4 _EquirectTintColor;
int _EquirectFlipHorizontal;
int _EquirectFlipVertical;
float _EquirectUVOffsetX;
float _EquirectUVOffsetY;
float _EquirectTileX;
float _EquirectTileY;
int _EquirectUseDistanceFiltering;
float _EquirectMinDistance;
float _EquirectMaxDistance;

// Quaternion rotation helper
float3 RotateVectorByQuaternion(float3 v, float4 q)
{
    float3 u = q.xyz;
    float s = q.w;
    return 2.0 * dot(u, v) * u + (s * s - dot(u, u)) * v + 2.0 * s * cross(u, v);
}

// Helper function to convert 3D direction to equirectangular UV
float2 DirectionToEquirectangularUV(float3 dir)
{
    // Normalize direction
    dir = normalize(dir);
    
    // Calculate spherical coordinates for equirectangular mapping
    // Longitude (theta): full 360° around Y axis
    // Latitude (phi): 180° from top to bottoms
    
    // Horizontal angle (longitude) - atan2 gives -π to π
    float theta = atan2(dir.x, dir.z);
    
    // Vertical angle (latitude) - use atan2 for full range
    float phi = atan2(dir.y, length(dir.xz));
    
    // Convert to UV coordinates [0, 1]
    // theta: -π to π -> 0 to 1
    float u = 0.5 - theta / (2.0 * 3.14159265359);
    
    // phi: -π/2 to π/2 -> 0 to 1  
    float v = 0.5 - phi / 3.14159265359;
    
    return float2(u, v);
}

[numthreads(GROUP_SIZE,1,1)]
void CSApplyEquirectangularProjection(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Early exit if opacity is 0 - don't modify splat colors at all
    if (_EquirectOpacity <= 0.0)
        return;
    
    // Get splat position in local space
    float3 splatPos = LoadSplatPos(idx);
    
    // Transform to world space
    float3 worldPos = mul(_MatrixObjectToWorld, float4(splatPos, 1)).xyz;
    
    // Calculate direction from projector to splat
    float3 directionToSplat = worldPos - _EquirectProjectorPosition;
    float distance = length(directionToSplat);
    
    // Apply distance filtering if enabled
    if (_EquirectUseDistanceFiltering != 0)
    {
        if (distance < _EquirectMinDistance || distance > _EquirectMaxDistance)
            return;
    }
    
    // Normalize direction
    float3 direction = directionToSplat / max(distance, 0.0001);
    
    // Apply inverse rotation to direction (rotate direction into projector's local space)
    // Inverse quaternion = conjugate for unit quaternions
    float4 invRotation = float4(-_EquirectProjectorRotation.xyz, _EquirectProjectorRotation.w);
    direction = RotateVectorByQuaternion(direction, invRotation);

    // Relative transform scale controls video zoom.
    float3 safeScale = max(abs(_EquirectProjectorScale), 0.0001);
    
    // Convert direction to equirectangular UV
    float2 uv = DirectionToEquirectangularUV(direction);
    uv = (uv - 0.5) / safeScale.xy + 0.5;
    
    // Apply UV flipping
    if (_EquirectFlipHorizontal != 0)
        uv.x = 1.0 - uv.x;
    if (_EquirectFlipVertical != 0)
        uv.y = 1.0 - uv.y;
    
    // Apply UV tiling and offset
    uv = uv * float2(_EquirectTileX, _EquirectTileY) + float2(_EquirectUVOffsetX, _EquirectUVOffsetY);
    
    // Sample equirectangular texture with high quality filtering
    float4 equirectColor = _EquirectTexture.SampleLevel(sampler_linear_repeat, uv, 0);
    
    // Apply tint color (multiply RGB, preserve alpha if tint alpha is 1.0)
    equirectColor.rgb *= _EquirectTintColor.rgb;
    equirectColor.a *= _EquirectTintColor.a;
    
    // Get current splat color
    uint3 pixelIndex = SplatIndexToPixelIndex(idx);
    float4 currentColor = _EquirectColorTexture[pixelIndex.xy];
    
    // Blend colors - all blend modes now properly respect opacity for preview/alignment
    float4 blendedColor = BlendDecalColor(currentColor, equirectColor, _EquirectBlendMode, _EquirectOpacity);
    
    // Write back to texture
    _EquirectColorTexture[pixelIndex.xy] = blendedColor;
}

// =====================================================
// Smudge Brush Kernel - GPU-accelerated splat smudging
// Optimized: early-out, fast sqrt approximation, reduced branching
// =====================================================
#pragma kernel CSSmudgeSplats

float3 _SmudgeCenter;
float3 _SmudgeDelta;
float _SmudgeRadius;
float _SmudgeFalloff;
float _SmudgeStrength;
int _SmudgeBlendColors;
float _SmudgeRadiusSq; // Pre-computed radius squared for faster comparison

[numthreads(256,1,1)]
void CSSmudgeSplats(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    uint posStride = 12;
    float3 pos = asfloat(_SplatPos.Load3(idx * posStride));
    
    // Fast squared distance check - avoid sqrt for out-of-range splats
    float3 toCenter = pos - _SmudgeCenter;
    float distSq = dot(toCenter, toCenter);
    float radiusSq = _SmudgeRadiusSq;
    
    if (distSq >= radiusSq)
        return;
    
    // Only compute sqrt for splats within radius
    float invRadius = 1.0 / _SmudgeRadius;
    float normalizedDistSq = distSq * invRadius * invRadius;
    
    // Fast falloff approximation using squared distance when falloff is near 0.5
    float falloffMult;
    if (_SmudgeFalloff < 0.01)
    {
        falloffMult = 1.0;
    }
    else if (_SmudgeFalloff > 0.45 && _SmudgeFalloff < 0.55)
    {
        // Linear falloff approximation (faster, no pow)
        falloffMult = 1.0 - sqrt(normalizedDistSq);
    }
    else
    {
        // Full calculation only when needed
        float normalizedDist = sqrt(normalizedDistSq);
        falloffMult = 1.0 - pow(normalizedDist, 1.0 / _SmudgeFalloff);
    }
    
    float3 movement = _SmudgeDelta * (falloffMult * _SmudgeStrength);
    float3 newPos = pos + movement;
    
    _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(newPos));
}

// =====================================================
// Pinch Brush Kernel - GPU-accelerated splat pinching
// Pulls splats toward or pushes away from center
// =====================================================
#pragma kernel CSPinchSplats

float3 _PinchCenter;
float _PinchRadius;
float _PinchFalloff;
float _PinchStrength;
float _PinchRadiusSq;

[numthreads(256,1,1)]
void CSPinchSplats(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    uint posStride = 12;
    float3 pos = asfloat(_SplatPos.Load3(idx * posStride));
    
    // Fast squared distance check
    float3 toCenter = _PinchCenter - pos;
    float distSq = dot(toCenter, toCenter);
    
    if (distSq >= _PinchRadiusSq)
        return;
    
    // Use same pattern as SmudgeSplats - avoid division issues
    float invRadius = 1.0 / _PinchRadius;
    float normalizedDistSq = distSq * invRadius * invRadius;
    
    // Falloff calculation matching SmudgeSplats pattern
    float falloffMult;
    if (_PinchFalloff < 0.01)
    {
        falloffMult = 1.0;
    }
    else if (_PinchFalloff > 0.45 && _PinchFalloff < 0.55)
    {
        falloffMult = 1.0 - sqrt(normalizedDistSq);
    }
    else
    {
        float normalizedDist = sqrt(normalizedDistSq);
        falloffMult = 1.0 - pow(normalizedDist, 1.0 / _PinchFalloff);
    }
    
    // Move toward center - use toCenter directly (already points toward center)
    // strength controls magnitude, falloffMult controls falloff
    float3 movement = toCenter * (falloffMult * _PinchStrength);
    float3 newPos = pos + movement;
    
    _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(newPos));
}

// =====================================================
// Flatten Brush Kernel - GPU-accelerated splat flattening
// Projects splats onto a plane defined by center point and normal
// =====================================================
#pragma kernel CSFlattenSplats

float3 _FlattenPlanePoint;   // A point on the flatten plane
float3 _FlattenPlaneNormal;  // Normal direction of the flatten plane (normalized)
float _FlattenRadius;
float _FlattenRadiusSq;
float _FlattenFalloff;
float _FlattenStrength;

[numthreads(256,1,1)]
void CSFlattenSplats(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    uint posStride = 12;
    float3 pos = asfloat(_SplatPos.Load3(idx * posStride));
    
    // Distance from splat to the plane point (center of brush)
    float3 toCenter = pos - _FlattenPlanePoint;
    float distSq = dot(toCenter, toCenter);
    
    if (distSq >= _FlattenRadiusSq)
        return;
    
    // Calculate signed distance from point to plane
    // Positive = in front of plane (in normal direction), Negative = behind
    float signedDistToPlane = dot(toCenter, _FlattenPlaneNormal);
    
    // Falloff based on distance from brush center
    float invRadius = 1.0 / _FlattenRadius;
    float normalizedDistSq = distSq * invRadius * invRadius;
    
    float falloffMult;
    if (_FlattenFalloff < 0.01)
    {
        falloffMult = 1.0;
    }
    else if (_FlattenFalloff > 0.45 && _FlattenFalloff < 0.55)
    {
        falloffMult = 1.0 - sqrt(normalizedDistSq);
    }
    else
    {
        float normalizedDist = sqrt(normalizedDistSq);
        falloffMult = 1.0 - pow(normalizedDist, 1.0 / _FlattenFalloff);
    }
    
    // Move splat toward the plane (reduce signed distance to zero)
    // Movement is along the plane normal, proportional to distance from plane
    float3 movement = -_FlattenPlaneNormal * signedDistToPlane * falloffMult * _FlattenStrength;
    float3 newPos = pos + movement;
    
    _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(newPos));
}

// =====================================================
// Relax Brush Kernel - GPU-accelerated splat relaxation
// Smooths splats by moving them toward local average positions
// Uses a grid-based approximation for neighbor averaging
// =====================================================
#pragma kernel CSRelaxSplats

float3 _RelaxCenter;
float _RelaxRadius;
float _RelaxRadiusSq;
float _RelaxFalloff;
float _RelaxStrength;
float _RelaxNeighborRadius;  // Radius to search for neighbors (as fraction of brush radius)
int _RelaxInvert;  // 0 = relax (smooth), 1 = roughen (scatter)

// Shared memory for local averaging (stores sum of positions and count)
groupshared float3 gs_LocalSum[256];
groupshared uint gs_LocalCount[256];

[numthreads(256,1,1)]
void CSRelaxSplats(uint3 id : SV_DispatchThreadID, uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex)
{
    uint idx = id.x;
    
    // Initialize shared memory
    gs_LocalSum[groupIndex] = float3(0, 0, 0);
    gs_LocalCount[groupIndex] = 0;
    
    GroupMemoryBarrierWithGroupSync();
    
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    uint posStride = 12;
    float3 pos = asfloat(_SplatPos.Load3(idx * posStride));
    
    // Distance from splat to brush center
    float3 toCenter = pos - _RelaxCenter;
    float distSq = dot(toCenter, toCenter);
    
    if (distSq >= _RelaxRadiusSq)
        return;
    
    float dist = sqrt(distSq);
    float invRadius = 1.0 / _RelaxRadius;
    float normalizedDist = dist * invRadius;
    
    // Falloff calculation
    float falloffMult;
    if (_RelaxFalloff < 0.01)
    {
        falloffMult = 1.0;
    }
    else if (_RelaxFalloff > 0.45 && _RelaxFalloff < 0.55)
    {
        falloffMult = 1.0 - normalizedDist;
    }
    else
    {
        falloffMult = 1.0 - pow(max(0.0, normalizedDist), 1.0 / _RelaxFalloff);
    }
    
    // Calculate neighbor search radius
    float neighborRadiusSq = _RelaxNeighborRadius * _RelaxNeighborRadius * _RelaxRadiusSq;
    
    // Find local average by sampling nearby splats
    // This is an approximation - we sample a subset of splats in the region
    float3 sumPos = pos;  // Include self
    uint count = 1;
    
    // Sample nearby splats - check splats in nearby indices
    // This is a simple approximation that works because splats are often spatially coherent
    uint searchRange = min(64u, _SplatCount / 4);
    uint startIdx = (idx > searchRange) ? idx - searchRange : 0;
    uint endIdx = min(idx + searchRange, _SplatCount - 1);
    
    for (uint i = startIdx; i <= endIdx; i += 3)  // Sample every 3rd for performance
    {
        if (i == idx) continue;
        
        float3 otherPos = asfloat(_SplatPos.Load3(i * posStride));
        float3 diff = otherPos - pos;
        float diffSq = dot(diff, diff);
        
        // Check if within neighbor radius and also within brush
        if (diffSq < neighborRadiusSq)
        {
            float3 otherToCenter = otherPos - _RelaxCenter;
            float otherDistSq = dot(otherToCenter, otherToCenter);
            if (otherDistSq < _RelaxRadiusSq)
            {
                sumPos += otherPos;
                count++;
            }
        }
    }
    
    // Calculate target position (average)
    float3 avgPos = sumPos / float(count);
    
    // Move toward or away from average position based on invert flag
    // invert = 0: relax/smooth (move toward average)
    // invert = 1: roughen/scatter (move away from average)
    float3 direction = avgPos - pos;
    if (_RelaxInvert != 0)
    {
        direction = -direction;  // Invert: move away from average
    }
    
    float3 movement = direction * falloffMult * _RelaxStrength;
    float3 newPos = pos + movement;
    
    _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(newPos));
}

// Restore positions to original in sphere kernel (for sculpt brush ALT mode)
#pragma kernel CSRestorePositionsInSphere

float3 _RestorePosCenter;
float _RestorePosRadius;
float _RestorePosRadiusSq;
float _RestorePosFalloff;
float _RestorePosStrength;

[numthreads(256,1,1)]
void CSRestorePositionsInSphere(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    uint posStride = 12;
    float3 pos = asfloat(_SplatPos.Load3(idx * posStride));
    float3 origPos = _SplatOriginalPositions[idx];
    
    // Distance from splat to brush center
    float3 toCenter = pos - _RestorePosCenter;
    float distSq = dot(toCenter, toCenter);
    
    if (distSq >= _RestorePosRadiusSq)
        return;
    
    float dist = sqrt(distSq);
    float invRadius = 1.0 / _RestorePosRadius;
    float normalizedDist = dist * invRadius;
    
    // Falloff calculation
    float falloffMult;
    if (_RestorePosFalloff < 0.01)
    {
        falloffMult = 1.0;
    }
    else if (_RestorePosFalloff > 0.45 && _RestorePosFalloff < 0.55)
    {
        falloffMult = 1.0 - normalizedDist;
    }
    else
    {
        falloffMult = 1.0 - pow(max(0.0, normalizedDist), 1.0 / _RestorePosFalloff);
    }
    
    // Lerp toward original position
    float3 newPos = lerp(pos, origPos, falloffMult * _RestorePosStrength);
    
    _SplatPos.Store3(idx * posStride, PackFloat3AsUintBits(newPos));
}

// Color adjustment in box variables
float3 _ColorAdjustBoxCenter;
float3 _ColorAdjustBoxSize;
float _ColorAdjustExposure;
float _ColorAdjustContrast;
float _ColorAdjustHueShift;
float _ColorAdjustSaturation;
float4 _ColorAdjustTint;
RWTexture2D<float4> _ColorAdjustTexture;

// Colorize in sphere variables
float3 _ColorizeSphereCenter;
float _ColorizeSphereRadius;
float4 _ColorizeTargetColor;
float _ColorizeBlendStrength;
float _ColorizeFalloff;
int _ColorizeBlendMode; // 0=Normal, 1=Multiply, 2=Screen, 3=Overlay, 4=Darken, 5=Lighten, 6=SoftLight, 7=HardLight, 8=ColorDodge, 9=ColorBurn
float _ColorizeBlendModeIntensity; // How much the blend mode effect is applied (0-1)
float _ColorizeNoiseStrength; // Noise strength for colorize brush
float _ColorizeNoiseScale; // Noise scale for colorize brush

// Blend mode helper functions for colorize brush
float3 ColorizeBlend_Multiply(float3 base, float3 blend)
{
    return base * blend;
}

float3 ColorizeBlend_Screen(float3 base, float3 blend)
{
    return 1.0 - (1.0 - base) * (1.0 - blend);
}

float3 ColorizeBlend_Overlay(float3 base, float3 blend)
{
    float3 result;
    result.r = base.r < 0.5 ? (2.0 * base.r * blend.r) : (1.0 - 2.0 * (1.0 - base.r) * (1.0 - blend.r));
    result.g = base.g < 0.5 ? (2.0 * base.g * blend.g) : (1.0 - 2.0 * (1.0 - base.g) * (1.0 - blend.g));
    result.b = base.b < 0.5 ? (2.0 * base.b * blend.b) : (1.0 - 2.0 * (1.0 - base.b) * (1.0 - blend.b));
    return result;
}

float3 ColorizeBlend_Darken(float3 base, float3 blend)
{
    return min(base, blend);
}

float3 ColorizeBlend_Lighten(float3 base, float3 blend)
{
    return max(base, blend);
}

float3 ColorizeBlend_SoftLight(float3 base, float3 blend)
{
    float3 result;
    result.r = blend.r < 0.5 ? (2.0 * base.r * blend.r + base.r * base.r * (1.0 - 2.0 * blend.r)) : (sqrt(base.r) * (2.0 * blend.r - 1.0) + 2.0 * base.r * (1.0 - blend.r));
    result.g = blend.g < 0.5 ? (2.0 * base.g * blend.g + base.g * base.g * (1.0 - 2.0 * blend.g)) : (sqrt(base.g) * (2.0 * blend.g - 1.0) + 2.0 * base.g * (1.0 - blend.g));
    result.b = blend.b < 0.5 ? (2.0 * base.b * blend.b + base.b * base.b * (1.0 - 2.0 * blend.b)) : (sqrt(base.b) * (2.0 * blend.b - 1.0) + 2.0 * base.b * (1.0 - blend.b));
    return result;
}

float3 ColorizeBlend_HardLight(float3 base, float3 blend)
{
    float3 result;
    result.r = blend.r < 0.5 ? (2.0 * base.r * blend.r) : (1.0 - 2.0 * (1.0 - base.r) * (1.0 - blend.r));
    result.g = blend.g < 0.5 ? (2.0 * base.g * blend.g) : (1.0 - 2.0 * (1.0 - base.g) * (1.0 - blend.g));
    result.b = blend.b < 0.5 ? (2.0 * base.b * blend.b) : (1.0 - 2.0 * (1.0 - base.b) * (1.0 - blend.b));
    return result;
}

float3 ColorizeBlend_ColorDodge(float3 base, float3 blend)
{
    return base / max(0.001, 1.0 - blend);
}

float3 ColorizeBlend_ColorBurn(float3 base, float3 blend)
{
    return 1.0 - (1.0 - base) / max(0.001, blend);
}

float3 ApplyColorizeBlendMode(float3 base, float3 blend, int mode)
{
    switch (mode)
    {
        case 1: return ColorizeBlend_Multiply(base, blend);
        case 2: return ColorizeBlend_Screen(base, blend);
        case 3: return ColorizeBlend_Overlay(base, blend);
        case 4: return ColorizeBlend_Darken(base, blend);
        case 5: return ColorizeBlend_Lighten(base, blend);
        case 6: return ColorizeBlend_SoftLight(base, blend);
        case 7: return ColorizeBlend_HardLight(base, blend);
        case 8: return saturate(ColorizeBlend_ColorDodge(base, blend));
        case 9: return saturate(ColorizeBlend_ColorBurn(base, blend));
        default: return blend; // Normal mode - just use blend color
    }
}

float3 ColorAdjust_RGBToHSV(float3 rgb)
{
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = rgb.g < rgb.b ? float4(rgb.bg, K.wz) : float4(rgb.gb, K.xy);
    float4 q = rgb.r < p.x ? float4(p.xyw, rgb.r) : float4(rgb.r, p.yzx);
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 ColorAdjust_HSVToRGB(float3 hsv)
{
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(hsv.xxx + K.xyz) * 6.0 - K.www);
    return hsv.z * lerp(K.xxx, saturate(p - K.xxx), hsv.y);
}

// Use 256 threads for better occupancy on color adjustment
[numthreads(256,1,1)]
void CSAdjustColorsInBox(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Only Float32 format supported, no chunks
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    // Read position directly (minimal memory access)
    float3 localPos = asfloat(_SplatPos.Load3(idx * 12));
    
    // Quick world-space transform and box check
    float3 worldPos = mul(_MatrixObjectToWorld, float4(localPos, 1)).xyz;
    float3 toCenter = worldPos - _ColorAdjustBoxCenter;
    float3 halfSize = _ColorAdjustBoxSize * 0.5;
    
    if (abs(toCenter.x) > halfSize.x || abs(toCenter.y) > halfSize.y || abs(toCenter.z) > halfSize.z)
        return;
    
    // Read current color
    uint3 pixelIndex = SplatIndexToPixelIndex(idx);
    float4 c = _ColorAdjustTexture[pixelIndex.xy];
    float originalAlpha = c.a;
    
    // Apply exposure
    float exposure = pow(2.0, _ColorAdjustExposure);
    c.rgb *= exposure;
    
    // Apply contrast
    float midPoint = 0.5;
    c.rgb = (c.rgb - midPoint) * _ColorAdjustContrast + midPoint;
    
    // Apply color tint
    c.rgb *= _ColorAdjustTint.rgb;
    
    // Apply hue shift and saturation
    if (abs(_ColorAdjustHueShift) > 0.1 || abs(_ColorAdjustSaturation - 1.0) > 0.001)
    {
        // Normalize for HSV conversion (handle HDR)
        float maxVal = max(c.r, max(c.g, c.b));
        float scale = maxVal > 1.0 ? maxVal : 1.0;
        float3 normalized = c.rgb / scale;
        
        float3 hsv = ColorAdjust_RGBToHSV(normalized);
        hsv.x = frac(hsv.x + _ColorAdjustHueShift / 360.0);
        hsv.y = saturate(hsv.y * _ColorAdjustSaturation);
        float3 adjusted = ColorAdjust_HSVToRGB(hsv);
        
        c.rgb = adjusted * scale;
    }
    
    // Clamp negative values, preserve HDR
    c.rgb = max(0, c.rgb);
    c.a = originalAlpha;
    
    // Write back
    _ColorAdjustTexture[pixelIndex.xy] = c;
}

// Colorize splats in sphere - blend existing colors toward target color
[numthreads(256,1,1)]
void CSColorizeInSphere(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Only Float32 format supported
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    // Read position
    float3 localPos = asfloat(_SplatPos.Load3(idx * 12));
    float3 worldPos = mul(_MatrixObjectToWorld, float4(localPos, 1)).xyz;
    
    // Sphere distance check
    float3 toCenter = worldPos - _ColorizeSphereCenter;
    float dist = length(toCenter);
    if (dist > _ColorizeSphereRadius)
        return;
    
    // Calculate blend factor with falloff
    float normalizedDist = dist / _ColorizeSphereRadius;
    float falloffFactor = 1.0 - saturate(pow(max(0.0, normalizedDist), 1.0 / max(0.01, _ColorizeFalloff)));
    
    // Apply noise to blend amount if noise strength > 0
    float noiseValue = 1.0;
    if (_ColorizeNoiseStrength > 0.001)
    {
        // Use world position for 3D noise
        float3 noisePos = worldPos * _ColorizeNoiseScale;
        // Simple 3D noise using sin functions
        float n = sin(noisePos.x * 12.9898 + noisePos.y * 78.233 + noisePos.z * 45.164) * 43758.5453;
        n = frac(n);
        // Add more octaves for richer noise
        n += sin(noisePos.x * 25.123 + noisePos.y * 156.456 + noisePos.z * 90.328) * 0.5;
        n += sin(noisePos.x * 50.246 + noisePos.y * 312.912 + noisePos.z * 180.656) * 0.25;
        n = frac(n);
        // Map to 0-1 range and apply strength
        noiseValue = lerp(1.0, n, _ColorizeNoiseStrength);
    }
    
    float blendAmount = _ColorizeBlendStrength * falloffFactor * noiseValue;
    
    // Skip if noise made blend amount too low
    if (blendAmount < 0.001)
        return;
    
    // Read current color
    uint3 pixelIndex = SplatIndexToPixelIndex(idx);
    float4 c = _ColorAdjustTexture[pixelIndex.xy];
    float originalAlpha = c.a;
    
    // Apply blend mode to get the blended color
    float3 blendModeResult = ApplyColorizeBlendMode(c.rgb, _ColorizeTargetColor.rgb, _ColorizeBlendMode);
    
    // Lerp between target color (normal) and blend mode result based on intensity
    float3 blendedColor = lerp(_ColorizeTargetColor.rgb, blendModeResult, _ColorizeBlendModeIntensity);
    
    // Lerp from current to blended based on strength and falloff
    c.rgb = lerp(c.rgb, blendedColor, blendAmount);
    c.a = originalAlpha;
    
    // Write back
    _ColorAdjustTexture[pixelIndex.xy] = c;
}

// Animation velocity painting variables
float3 _VelocitySphereCenter;
float _VelocitySphereRadius;
float3 _VelocityDirection;
int _VelocityAnimStyle; // 0=River, 1=Whirlpool, 2=Wave, 3=RandomLeaves
float _VelocityNoiseStrength;
float _VelocityNoiseScale;
int _VelocityDisableGravity; // 1 = zero out Y velocity to prevent falling

[numthreads(256,1,1)]
void CSApplyVelocityInSphere(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Only Float32 format supported
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    // Read position
    float3 localPos = asfloat(_SplatPos.Load3(idx * 12));
    float3 worldPos = mul(_MatrixObjectToWorld, float4(localPos, 1)).xyz;
    
    // Sphere distance check
    float3 toCenter = worldPos - _VelocitySphereCenter;
    float dist = length(toCenter);
    if (dist > _VelocitySphereRadius)
        return;
    
    // Calculate falloff based on distance
    float normalizedDist = dist / _VelocitySphereRadius;
    float falloff = 1.0 - saturate(normalizedDist * normalizedDist);
    
    // Get current velocity
    float3 currentVel = _SplatVelocities[idx];
    
    // Calculate new velocity based on animation style
    float3 newVel = float3(0, 0, 0);
    
    if (_VelocityAnimStyle == 0) // River - direct flow
    {
        newVel = _VelocityDirection;
    }
    else if (_VelocityAnimStyle == 1) // Whirlpool - spiral around center
    {
        float3 toSplat = worldPos - _VelocitySphereCenter;
        toSplat.y = 0; // Keep on horizontal plane
        float3 tangent = normalize(cross(float3(0, 1, 0), toSplat));
        float3 inward = -normalize(toSplat);
        // Combine tangent (rotation) with inward pull
        newVel = (tangent * 0.8 + inward * 0.2) * length(_VelocityDirection);
    }
    else if (_VelocityAnimStyle == 2) // Wave - oscillate perpendicular
    {
        float3 perpDir = normalize(cross(_VelocityDirection, float3(0, 1, 0)));
        if (length(perpDir) < 0.01)
            perpDir = normalize(cross(_VelocityDirection, float3(1, 0, 0)));
        float phase = dot(worldPos, _VelocityDirection) * 2.0 + _CustomTime * 3.0;
        newVel = perpDir * sin(phase) * length(_VelocityDirection);
    }
    else if (_VelocityAnimStyle == 3) // Random leaves - chaotic drift
    {
        // Use position-based noise for variety
        float3 noisePos = worldPos * _VelocityNoiseScale + _CustomTime * 0.5;
        float nx = sin(noisePos.x * 12.9898 + noisePos.y * 78.233) * 43758.5453;
        float ny = sin(noisePos.y * 12.9898 + noisePos.z * 78.233) * 43758.5453;
        float nz = sin(noisePos.z * 12.9898 + noisePos.x * 78.233) * 43758.5453;
        float3 randomDir = normalize(float3(frac(nx) - 0.5, frac(ny) * 0.3 - 0.15, frac(nz) - 0.5));
        newVel = (_VelocityDirection * 0.5 + randomDir * 0.5) * length(_VelocityDirection);
    }
    
    // Apply noise variation
    if (_VelocityNoiseStrength > 0.001)
    {
        float3 noisePos = worldPos * _VelocityNoiseScale;
        float n = sin(noisePos.x * 12.9898 + noisePos.y * 78.233 + noisePos.z * 45.164) * 43758.5453;
        n = frac(n);
        float3 noiseOffset = float3(
            sin(noisePos.x * 25.123 + _CustomTime) * 2.0 - 1.0,
            sin(noisePos.y * 35.456 + _CustomTime * 1.3) * 2.0 - 1.0,
            sin(noisePos.z * 45.789 + _CustomTime * 0.7) * 2.0 - 1.0
        ) * _VelocityNoiseStrength;
        newVel += noiseOffset * length(_VelocityDirection);
    }
    
    // Blend with existing velocity using falloff
    float3 finalVel = lerp(currentVel, newVel, falloff);
    
    // Zero out Y velocity if gravity is disabled to keep splats flowing horizontally
    if (_VelocityDisableGravity == 1)
    {
        finalVel.y = 0;
        
        // Set per-splat no-gravity flag (persists across frames)
        uint flagWordIdx = idx / 32;
        uint flagBitIdx = idx & 31;
        _SplatAnimFlags.InterlockedOr(flagWordIdx * 4, 1u << flagBitIdx);
    }
    
    // Write back velocity to both current and persistent buffers
    _SplatVelocities[idx] = finalVel;
    _SplatPersistentVelocities[idx] = finalVel; // Store for continuous animation
}

// Apply persistent velocities to maintain continuous animation
[numthreads(256,1,1)]
void CSApplyPersistentVelocities(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    float3 persistentVel = _SplatPersistentVelocities[idx];
    
    // Only apply if there's a persistent velocity set
    float persistentMag = length(persistentVel);
    if (persistentMag > 0.001)
    {
        // Reset velocity to persistent value for continuous animation
        _SplatVelocities[idx] = persistentVel;
    }
}

// =====================================================
// Collision Breaking System - GPU-accelerated splat collision and chunking
// =====================================================

// Rigidbody collision data from Unity
struct RigidbodyCollisionData
{
    float3 position;
    float3 velocity;
    float3 angularVelocity;
    float radius;
    float mass;
    float impactForce;
    uint colliderType; // 0=Sphere, 1=Box, 2=Capsule
    float3 boxSize;
    float3 capsuleAxis;
    float capsuleHeight;
};

// Chunk data for broken splat groups
struct SplatChunkData
{
    float3 centerOfMass;
    float3 velocity;
    float3 angularVelocity;
    float totalMass;
    uint startIndex;
    uint splatCount;
    uint chunkLevel; // 0=16x16, 1=32x32, 2=64x64, 3=128x128
    uint isActive;
    float3 boundMin;
    float3 boundMax;
};

StructuredBuffer<RigidbodyCollisionData> _RigidbodyColliders;
uint _RigidbodyColliderCount;

RWStructuredBuffer<SplatChunkData> _SplatChunksPhysics;
RWStructuredBuffer<uint> _SplatChunkAssignment; // Which chunk each splat belongs to (0 = no chunk)
RWByteAddressBuffer _CollisionHitFlags; // Bit flags for splats that were hit
RWStructuredBuffer<uint> _ChunkCounter; // Atomic counter for new chunks

float _BreakForceThreshold;
float _ChunkSplatRadius; // Radius for grouping splats into chunks
float _SelfCollisionRadius;
float _SelfCollisionStrength;
uint _MaxChunks;
uint _ChunkLevel; // 0=16, 1=32, 2=64, 3=128

// Get chunk size from level
uint GetChunkSize(uint level)
{
    if (level == 0) return 16;
    if (level == 1) return 32;
    if (level == 2) return 64;
    return 128;
}

// Check if point is inside rigidbody collider
bool IsInsideRigidbody(float3 worldPos, RigidbodyCollisionData rb, inout float penetration, inout float3 normal)
{
    if (rb.colliderType == 0) // Sphere
    {
        float3 toPoint = worldPos - rb.position;
        float dist = length(toPoint);
        if (dist < rb.radius)
        {
            penetration = rb.radius - dist;
            normal = dist > 0.001 ? toPoint / dist : float3(0, 1, 0);
            return true;
        }
    }
    else if (rb.colliderType == 1) // Box
    {
        float3 localPos = worldPos - rb.position;
        float3 halfSize = rb.boxSize * 0.5;
        float3 absLocal = abs(localPos);
        
        if (all(absLocal < halfSize))
        {
            float3 distToFaces = halfSize - absLocal;
            penetration = min(distToFaces.x, min(distToFaces.y, distToFaces.z));
            
            if (distToFaces.x <= distToFaces.y && distToFaces.x <= distToFaces.z)
                normal = float3(localPos.x >= 0.0 ? 1.0 : -1.0, 0.0, 0.0);
            else if (distToFaces.y <= distToFaces.z)
                normal = float3(0.0, localPos.y >= 0.0 ? 1.0 : -1.0, 0.0);
            else
                normal = float3(0.0, 0.0, localPos.z >= 0.0 ? 1.0 : -1.0);
            return true;
        }
    }
    else if (rb.colliderType == 2) // Capsule
    {
        float3 axis = rb.capsuleAxis;
        float axisLenSq = dot(axis, axis);
        axis = axisLenSq > 1e-6 ? axis * rsqrt(axisLenSq) : float3(0, 1, 0);
        float halfHeight = rb.capsuleHeight * 0.5 - rb.radius;
        float3 p1 = rb.position - axis * halfHeight;
        float3 p2 = rb.position + axis * halfHeight;
        
        float3 d = p2 - p1;
        float dLenSq = dot(d, d);
        float t = dLenSq > 1e-6 ? saturate(dot(worldPos - p1, d) / dLenSq) : 0.0;
        float3 closest = p1 + t * d;
        
        float3 toPoint = worldPos - closest;
        float dist = length(toPoint);
        if (dist < rb.radius)
        {
            penetration = rb.radius - dist;
            normal = dist > 0.001 ? toPoint / dist : float3(0, 1, 0);
            return true;
        }
    }
    
    return false;
}

// Detect collisions with rigidbodies and mark hit splats
[numthreads(256,1,1)]
void CSDetectRigidbodyCollisions(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    float3 localPos = asfloat(_SplatPos.Load3(idx * 12));
    float3 worldPos = mul(_MatrixObjectToWorld, float4(localPos, 1)).xyz;
    
    float3 totalForce = float3(0, 0, 0);
    bool wasHit = false;
    
    for (uint i = 0; i < _RigidbodyColliderCount; i++)
    {
        RigidbodyCollisionData rb = _RigidbodyColliders[i];
        
        float penetration = 0;
        float3 normal = float3(0, 1, 0);
        
        if (IsInsideRigidbody(worldPos, rb, penetration, normal))
        {
            wasHit = true;
            
            // Calculate impact force
            float impactSpeed = length(rb.velocity);
            float impactForce = rb.mass * impactSpeed * rb.impactForce;
            
            // Apply force in collision normal direction
            float3 force = normal * impactForce;
            
            // Add tangential force from angular velocity
            float3 r = worldPos - rb.position;
            float3 tangentVel = cross(rb.angularVelocity, r);
            force += tangentVel * rb.mass * 0.5;
            
            totalForce += force;
            
            // Push splat out of collider
            float3 pushOut = normal * penetration * 1.1;
            float3 newWorldPos = worldPos + pushOut;
            float3 newLocalPos = mul(_MatrixWorldToObject, float4(newWorldPos, 1)).xyz;
            _SplatPos.Store3(idx * 12, PackFloat3AsUintBits(newLocalPos));
        }
    }
    
    if (wasHit)
    {
        // Mark as hit
        uint wordIdx = idx / 32;
        uint bitIdx = idx & 31;
        _CollisionHitFlags.InterlockedOr(wordIdx * 4, 1u << bitIdx);
        
        // Apply force as velocity
        float3 localForce = mul((float3x3)_MatrixWorldToObject, totalForce);
        _SplatVelocities[idx] += localForce * 0.1;
    }
}

// Mark chunk boundaries and assign splats to chunks
[numthreads(256,1,1)]
void CSMarkChunkBoundaries(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    // Check if this splat was hit
    uint wordIdx = idx / 32;
    uint bitIdx = idx & 31;
    uint hitWord = _CollisionHitFlags.Load(wordIdx * 4);
    
    if ((hitWord & (1u << bitIdx)) == 0)
        return; // Not hit, skip
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    float3 pos = asfloat(_SplatPos.Load3(idx * 12));
    
    // Calculate spatial hash for chunk assignment
    uint chunkSize = 128;
    chunkSize = GetChunkSize(_ChunkLevel);
    float gridSize = _ChunkSplatRadius * chunkSize;
    
    int3 gridPos = int3(floor(pos / gridSize));
    uint hash = (uint)(gridPos.x * 73856093) ^ (uint)(gridPos.y * 19349663) ^ (uint)(gridPos.z * 83492791);
    uint chunkId = (hash % (_MaxChunks - 1)) + 1; // 0 = no chunk
    
    // Atomically assign chunk
    uint prevChunk;
    InterlockedCompareExchange(_SplatChunkAssignment[idx], 0, chunkId, prevChunk);
    
    if (prevChunk == 0)
    {
        // First time assignment, increment chunk splat counter
        InterlockedAdd(_ChunkCounter[chunkId], 1);
    }
}

// Apply forces to chunk groups
[numthreads(256,1,1)]
void CSApplyChunkForces(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint chunkId = _SplatChunkAssignment[idx];
    if (chunkId == 0)
        return; // Not in any chunk
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    SplatChunkData chunk = _SplatChunksPhysics[chunkId];
    if (chunk.isActive == 0)
        return;
    
    float3 pos = asfloat(_SplatPos.Load3(idx * 12));
    
    // Apply chunk velocity
    float3 newVel = _SplatVelocities[idx];
    newVel += chunk.velocity * _DeltaTime;
    
    // Apply angular velocity around center of mass
    float3 r = pos - chunk.centerOfMass;
    float3 tangentVel = cross(chunk.angularVelocity, r);
    newVel += tangentVel * _DeltaTime;
    
    // Apply gravity
    newVel.y -= _Gravity * _DeltaTime;
    
    // Damping
    newVel *= (1.0 - _Damping * _DeltaTime);
    
    _SplatVelocities[idx] = newVel;
    
    // Update position
    float3 newPos = pos + newVel * _DeltaTime;
    _SplatPos.Store3(idx * 12, PackFloat3AsUintBits(newPos));
}

// Self-collision detection between splats
[numthreads(256,1,1)]
void CSSelfCollision(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;
    
    uint fmt = _SplatFormat & 0xFF;
    if (_SplatChunkCount != 0 || fmt != VECTOR_FMT_32F)
        return;
    
    float3 pos = asfloat(_SplatPos.Load3(idx * 12));
    float3 vel = _SplatVelocities[idx];
    
    // Only check splats with velocity (in motion)
    if (length(vel) < 0.001)
        return;
    
    float3 totalPush = float3(0, 0, 0);
    uint collisionCount = 0;
    
    // Sample nearby splats (stochastic for performance)
    uint seed = idx + asuint(_CustomTime);
    for (uint i = 0; i < 16; i++)
    {
        seed = pcg_hash(seed);
        uint otherIdx = seed % _SplatCount;
        
        if (otherIdx == idx)
            continue;
        
        float3 otherPos = asfloat(_SplatPos.Load3(otherIdx * 12));
        float3 diff = pos - otherPos;
        float dist = length(diff);
        
        if (dist < _SelfCollisionRadius && dist > 0.0001)
        {
            float3 pushDir = diff / dist;
            float overlap = _SelfCollisionRadius - dist;
            totalPush += pushDir * overlap * _SelfCollisionStrength;
            collisionCount++;
        }
    }
    
    if (collisionCount > 0)
    {
        // Apply push force
        vel += totalPush / collisionCount;
        _SplatVelocities[idx] = vel;
    }
}

// Break splats into chunks based on collision impact
[numthreads(256,1,1)]
void CSBreakIntoChunks(uint3 id : SV_DispatchThreadID)
{
    uint chunkIdx = id.x;
    if (chunkIdx >= _MaxChunks)
        return;
    
    uint splatCountInChunk = _ChunkCounter[chunkIdx];
    if (splatCountInChunk == 0)
        return;
    
    // Calculate chunk properties
    float3 centerSum = float3(0, 0, 0);
    float3 velSum = float3(0, 0, 0);
    float3 boundMin = float3(1e38, 1e38, 1e38);
    float3 boundMax = float3(-1e38, -1e38, -1e38);
    uint actualCount = 0;
    
    // First pass: calculate center of mass and bounds
    for (uint i = 0; i < _SplatCount && actualCount < splatCountInChunk; i++)
    {
        if (_SplatChunkAssignment[i] == chunkIdx)
        {
            uint fmt = _SplatFormat & 0xFF;
            if (_SplatChunkCount == 0 && fmt == VECTOR_FMT_32F)
            {
                float3 pos = asfloat(_SplatPos.Load3(i * 12));
                float3 vel = _SplatVelocities[i];
                
                centerSum += pos;
                velSum += vel;
                boundMin = min(boundMin, pos);
                boundMax = max(boundMax, pos);
                actualCount++;
            }
        }
    }
    
    if (actualCount == 0)
        return;
    
    // Update chunk data
    SplatChunkData chunk;
    chunk.centerOfMass = centerSum / actualCount;
    chunk.velocity = velSum / actualCount;
    chunk.angularVelocity = float3(0, 0, 0); // Could compute from velocities
    chunk.totalMass = actualCount * _SplatMass;
    chunk.startIndex = 0; // Not contiguous
    chunk.splatCount = actualCount;
    chunk.chunkLevel = _ChunkLevel;
    chunk.isActive = 1;
    chunk.boundMin = boundMin;
    chunk.boundMax = boundMax;
    
    _SplatChunksPhysics[chunkIdx] = chunk;
}

// ---- LoD streaming: copy page splats into unified atlas / gather active set ----
uint _LodCopyCount;
uint _LodCopyDstOffset;
uint _LodPosWordsPerSplat;
uint _LodOtherWordsPerSplat;
uint _LodShWordsPerSplat;
ByteAddressBuffer _LodCopySrcPos;
ByteAddressBuffer _LodCopySrcOther;
ByteAddressBuffer _LodCopySrcSh;
RWByteAddressBuffer _LodCopyDstPos;
RWByteAddressBuffer _LodCopyDstOther;
RWByteAddressBuffer _LodCopyDstSh;

[numthreads(GROUP_SIZE, 1, 1)]
void CSCopyBufferRange(uint3 id : SV_DispatchThreadID)
{
    uint splatIdx = id.x;
    if (splatIdx >= _LodCopyCount)
        return;
    uint dstIdx = splatIdx + _LodCopyDstOffset;
    uint srcPosBase = splatIdx * _LodPosWordsPerSplat;
    uint dstPosBase = dstIdx * _LodPosWordsPerSplat;
    uint wordIdx;
    for (wordIdx = 0; wordIdx < _LodPosWordsPerSplat; ++wordIdx)
    {
        uint srcAddr = (srcPosBase + wordIdx) << 2;
        uint dstAddr = (dstPosBase + wordIdx) << 2;
        _LodCopyDstPos.Store(dstAddr, _LodCopySrcPos.Load(srcAddr));
    }
    uint srcOtherBase = splatIdx * _LodOtherWordsPerSplat;
    uint dstOtherBase = dstIdx * _LodOtherWordsPerSplat;
    for (wordIdx = 0; wordIdx < _LodOtherWordsPerSplat; ++wordIdx)
    {
        uint srcAddr = (srcOtherBase + wordIdx) << 2;
        uint dstAddr = (dstOtherBase + wordIdx) << 2;
        _LodCopyDstOther.Store(dstAddr, _LodCopySrcOther.Load(srcAddr));
    }
    uint srcShBase = splatIdx * _LodShWordsPerSplat;
    uint dstShBase = dstIdx * _LodShWordsPerSplat;
    for (wordIdx = 0; wordIdx < _LodShWordsPerSplat; ++wordIdx)
    {
        uint srcAddr = (srcShBase + wordIdx) << 2;
        uint dstAddr = (dstShBase + wordIdx) << 2;
        _LodCopyDstSh.Store(dstAddr, _LodCopySrcSh.Load(srcAddr));
    }
}

StructuredBuffer<uint> _LodGatherAtlasIndices;
StructuredBuffer<uint> _LodUnifiedPos;
StructuredBuffer<uint> _LodUnifiedOther;
StructuredBuffer<uint> _LodUnifiedSh;
RWStructuredBuffer<uint> _LodOutPos;
RWStructuredBuffer<uint> _LodOutOther;
RWStructuredBuffer<uint> _LodOutSh;
uint _LodActiveCount;

[numthreads(GROUP_SIZE, 1, 1)]
void CSGatherLodSplats(uint3 id : SV_DispatchThreadID)
{
    uint outIdx = id.x;
    if (outIdx >= _LodActiveCount)
        return;
    uint atlasIdx = _LodGatherAtlasIndices[outIdx];
    uint posBaseIn = atlasIdx * _LodPosWordsPerSplat;
    uint posBaseOut = outIdx * _LodPosWordsPerSplat;
    uint wordIdx;
    for (wordIdx = 0; wordIdx < _LodPosWordsPerSplat; ++wordIdx)
        _LodOutPos[posBaseOut + wordIdx] = _LodUnifiedPos[posBaseIn + wordIdx];
    uint otherBaseIn = atlasIdx * _LodOtherWordsPerSplat;
    uint otherBaseOut = outIdx * _LodOtherWordsPerSplat;
    for (wordIdx = 0; wordIdx < _LodOtherWordsPerSplat; ++wordIdx)
        _LodOutOther[otherBaseOut + wordIdx] = _LodUnifiedOther[otherBaseIn + wordIdx];
    uint shBaseIn = atlasIdx * _LodShWordsPerSplat;
    uint shBaseOut = outIdx * _LodShWordsPerSplat;
    for (wordIdx = 0; wordIdx < _LodShWordsPerSplat; ++wordIdx)
        _LodOutSh[shBaseOut + wordIdx] = _LodUnifiedSh[shBaseIn + wordIdx];
}

